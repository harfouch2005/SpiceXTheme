    "faq": {
      "type": "spx-faq",
      "blocks": {
        "q1": {
          "type": "question",
          "settings": {
            "question": "Will this actually make my chicken taste good?",
            "answer": "<p>That is the whole job. Coat your food evenly before you cook. Six flavors, so the same chicken can be tacos on Monday and honey BBQ on Thursday.</p>"
          }
        },
        "q2": {
          "type": "question",
          "settings": {
            "question": "Does it add calories or sugar?",
            "answer": "<p>Very little. A serving is 1/4 teaspoon. Golden Hive and Sweet Sriracha get their sweetness from sugar and honey granules, and Taco Blast and Oh' Cajun have a small amount of cane sugar. Daily Blend and Bella Blend have none. The full nutrition panel is on every product page.</p>"
          }
        },
        "q3": {
          "type": "question",
          "settings": {
            "question": "Which one do I start with?",
            "answer": "<p>Daily Blend if you want one jar for everything. The Full Six if you want a different dinner every night. It is $12.95 cheaper than buying them one by one.</p>"
          }
        },
        "q4": {
          "type": "question",
          "settings": {
            "question": "How does shipping work?",
            "answer": "<p>Free shipping on any order with 2 or more jars, and bundles always ship free. Single jar orders ship for a flat $4.99.</p>"
          }
        },
        "q5": {
          "type": "question",
          "settings": {
            "question": "What if I don't love it?",
            "answer": "<p>Every SpiceX order comes with a 30-day money back guarantee. If you are not happy with it, email us within 30 days.</p>"
          }
        },
        "q6": {
          "type": "question",
          "settings": {
            "question": "Do you ship outside the US?",
            "answer": "<p>Right now we ship within the US only. Sign up for our newsletter and we'll let you know the moment we expand internationally.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4",
        "q5",
        "q6"
      ],

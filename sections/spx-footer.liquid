{%- comment -%}
  SpiceX Custom Footer · dark luxe footer with brand mark, newsletter, link columns, socials
  - Massive Fraunces brand wordmark at top (optional)
  - Multi-column nav blocks
  - Newsletter signup via Shopify customer form
  - Social icons + trust strip
  - Bottom row with copyright + legal links
  - All CSS scoped under #shopify-section-{{ section.id }}
{%- endcomment -%}


{% style %}
  #shopify-section-{{ section.id }} {
    --ft-bg: {{ section.settings.bg_color | default: '#0a0a0a' }};
    --ft-ink: {{ section.settings.text_color | default: '#ffffff' }};
    --ft-ink-mute: {{ section.settings.muted_color | default: 'rgba(255, 255, 255, 0.55)' }};
    --ft-ink-dim: rgba(22, 18, 14, 0.55);
    --ft-line: rgba(22, 18, 14, 0.14);
    --ft-accent: {{ section.settings.accent_color | default: '#e8a823' }};
    --ft-display: var(--spx-font-display);
    --ft-body: var(--spx-font-body);
    --ft-script: 'Caveat', cursive;
    --ft-ease: cubic-bezier(0.22, 1, 0.36, 1);

    background: var(--ft-bg);
    color: var(--ft-ink);
    font-family: var(--ft-body);
    box-sizing: border-box;
    position: relative;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after { box-sizing: border-box; }

  /* Soft gold glow */
  #shopify-section-{{ section.id }}::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 80% 40% at 50% -20%, color-mix(in srgb, var(--ft-accent) 12%, transparent), transparent 60%);
    pointer-events: none;
    z-index: 0;
  }

  #shopify-section-{{ section.id }} .ftr {
    position: relative;
    z-index: 1;
    max-width: 1480px;
    margin: 0 auto;
    padding: clamp(64px, 8vw, 112px) clamp(20px, 4vw, 56px) clamp(32px, 4vw, 56px);
  }

  #shopify-section-{{ section.id }} .ftr-logo { display: block; text-align: center; margin: 0 0 clamp(36px, 5vw, 64px); }
  #shopify-section-{{ section.id }} .ftr-logo img { width: min(300px, 58vw); height: auto; display: inline-block; }
  /* ===== Giant brand wordmark ===== */
  #shopify-section-{{ section.id }} .ftr-wordmark {
    font-family: var(--ft-display);
    font-weight: 500;
    font-size: clamp(64px, 14vw, 220px);
    line-height: 0.85;
    letter-spacing: -0.045em;
    color: var(--ft-ink);
    text-align: center;
    margin: 0 0 clamp(48px, 6vw, 80px);
    font-variation-settings: "WONK" 0, "SOFT" 30, "opsz" 144;
    user-select: none;
  }
  #shopify-section-{{ section.id }} .ftr-wordmark em {
    font-style: italic;
    color: var(--ft-accent);
    font-variation-settings: "WONK" 0, "SOFT" 50, "opsz" 144;
  }

  /* ===== Top grid: brand | columns ===== */
  #shopify-section-{{ section.id }} .ftr-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: clamp(32px, 4vw, 64px);
    align-items: start;
    padding-bottom: clamp(48px, 5vw, 64px);
    border-bottom: 1px solid var(--ft-line);
  }

  /* Brand column */
  #shopify-section-{{ section.id }} .ftr-brand { max-width: 360px; }
  #shopify-section-{{ section.id }} .ftr-tagline {
    font-family: var(--ft-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(17px, 1.6vw, 20px);
    line-height: 1.35;
    color: var(--ft-ink);
    margin: 0 0 28px;
    font-variation-settings: "WONK" 0, "SOFT" 40, "opsz" 144;
  }
  #shopify-section-{{ section.id }} .ftr-tagline em {
    color: var(--ft-accent);
  }

  /* Newsletter */
  #shopify-section-{{ section.id }} .ftr-news-label {
    font-family: var(--ft-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--ft-ink-mute);
    margin: 0 0 12px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .ftr-news {
    display: flex;
    align-items: stretch;
    background: transparent;
    border: 1px solid var(--ft-line);
    border-radius: 100px;
    overflow: hidden;
    max-width: 340px;
    transition: border-color 0.25s ease;
  }
  #shopify-section-{{ section.id }} .ftr-news:focus-within {
    border-color: var(--ft-accent);
  }
  #shopify-section-{{ section.id }} .ftr-news input[type="email"] {
    flex: 1;
    background: transparent;
    border: 0;
    padding: 12px 18px;
    color: var(--ft-ink);
    font-family: var(--ft-body);
    font-size: 13px;
    outline: 0;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .ftr-news input[type="email"]::placeholder { color: var(--ft-ink-dim); }
  #shopify-section-{{ section.id }} .ftr-news button {
    background: var(--ft-accent);
    color: #0a0a0a;
    border: 0;
    padding: 10px 16px;
    margin: 4px;
    border-radius: 100px;
    font-family: var(--ft-body);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
    line-height: 1;
    transition: filter 0.2s ease, transform 0.2s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .ftr-news button:hover {
    filter: brightness(1.08);
    transform: translateX(2px);
  }
  #shopify-section-{{ section.id }} .ftr-news button svg { width: 12px; height: 12px; }
  #shopify-section-{{ section.id }} .ftr-news-success,
  #shopify-section-{{ section.id }} .ftr-news-error {
    font-family: var(--ft-script);
    font-weight: 600;
    font-size: 18px;
    color: var(--ft-accent);
    margin: 14px 0 0;
  }
  #shopify-section-{{ section.id }} .ftr-news-error { color: #e07b3e; }

  /* ===== Link columns ===== */
  #shopify-section-{{ section.id }} .ftr-col {
    display: flex;
    flex-direction: column;
  }
  #shopify-section-{{ section.id }} .ftr-col-heading {
    font-family: var(--ft-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--ft-ink-mute);
    margin: 0 0 18px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .ftr-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  #shopify-section-{{ section.id }} .ftr-col a {
    font-family: var(--ft-body);
    font-size: 14px;
    font-weight: 400;
    color: var(--ft-ink);
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }
  #shopify-section-{{ section.id }} .ftr-col a:hover {
    color: var(--ft-accent);
    transform: translateX(3px);
  }

  /* ===== Social + trust strip ===== */
  #shopify-section-{{ section.id }} .ftr-mid {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
    padding: clamp(28px, 3vw, 40px) 0;
    border-bottom: 1px solid var(--ft-line);
  }
  #shopify-section-{{ section.id }} .ftr-socials {
    display: flex;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .ftr-social {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--ft-line);
    color: var(--ft-ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .ftr-social:hover {
    background: var(--ft-accent);
    color: #0a0a0a;
    border-color: var(--ft-accent);
    transform: translateY(-2px);
  }
  #shopify-section-{{ section.id }} .ftr-social svg { width: 18px; height: 18px; }

  #shopify-section-{{ section.id }} .ftr-trust {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .ftr-trust li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    color: var(--ft-ink-mute);
    font-family: var(--ft-body);
  }
  #shopify-section-{{ section.id }} .ftr-trust svg {
    width: 14px;
    height: 14px;
    color: var(--ft-accent);
    flex: 0 0 auto;
  }

  /* ===== Bottom bar ===== */
  #shopify-section-{{ section.id }} .ftr-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 16px;
    padding-top: clamp(20px, 2.5vw, 32px);
  }
  #shopify-section-{{ section.id }} .ftr-copy {
    font-family: var(--ft-body);
    font-size: 12px;
    color: var(--ft-ink-dim);
    margin: 0;
    letter-spacing: 0.04em;
  }
  #shopify-section-{{ section.id }} .ftr-legal {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #shopify-section-{{ section.id }} .ftr-legal a {
    font-family: var(--ft-body);
    font-size: 12px;
    color: var(--ft-ink-mute);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  #shopify-section-{{ section.id }} .ftr-legal a:hover { color: var(--ft-ink); }
  #shopify-section-{{ section.id }} .ftr-legal li + li::before {
    content: '·';
    margin-right: 16px;
    color: var(--ft-ink-dim);
  }

  /* ===== Tablet ===== */
  @media (max-width: 1024px) {
    #shopify-section-{{ section.id }} .ftr-grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    #shopify-section-{{ section.id }} .ftr-brand { grid-column: 1 / -1; max-width: 100%; }
    #shopify-section-{{ section.id }} .ftr-news { max-width: 420px; }
    #shopify-section-{{ section.id }} .ftr-wordmark { font-size: clamp(56px, 14vw, 120px); }
  }

  /* ===== Mobile ===== */
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} .ftr-grid {
      grid-template-columns: 1fr;
      gap: 36px;
    }
    #shopify-section-{{ section.id }} .ftr-wordmark { font-size: 64px; margin-bottom: 40px; }
    #shopify-section-{{ section.id }} .ftr-tagline { font-size: 16px; }
    #shopify-section-{{ section.id }} .ftr-mid {
      flex-direction: column;
      align-items: flex-start;
      gap: 20px;
    }
    #shopify-section-{{ section.id }} .ftr-bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
{% endstyle %}

{%- liquid
  assign socials_present = false
  if section.settings.instagram_url != blank
    assign socials_present = true
  endif
  if section.settings.tiktok_url != blank
    assign socials_present = true
  endif
  if section.settings.facebook_url != blank
    assign socials_present = true
  endif
  if section.settings.youtube_url != blank
    assign socials_present = true
  endif
  if section.settings.twitter_url != blank
    assign socials_present = true
  endif
-%}

<footer class="ftr-section" role="contentinfo">
  <div class="ftr">
    {%- if section.settings.logo != blank -%}
      <a class="ftr-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">{{ section.settings.logo | image_url: width: 800 | image_tag: loading: 'lazy', alt: shop.name }}</a>
    {%- elsif section.settings.show_wordmark and section.settings.wordmark != blank -%}
      <h2 class="ftr-wordmark" aria-hidden="true">{{ section.settings.wordmark }}</h2>
    {%- endif -%}

    <div class="ftr-grid">
      {%- comment -%} ===== Brand + newsletter column ===== {%- endcomment -%}
      <div class="ftr-brand">
        {%- if section.settings.tagline != blank -%}
          <p class="ftr-tagline">{{ section.settings.tagline }}</p>
        {%- endif -%}

        {%- if section.settings.newsletter_label != blank -%}
          <p class="ftr-news-label">{{ section.settings.newsletter_label | escape }}</p>
        {%- endif -%}
        {% form 'customer', class: 'ftr-news' %}
          {% if form.posted_successfully? %}
            <p class="ftr-news-success">You're in. Welcome to SpiceX.</p>
          {% else %}
            <input type="hidden" name="contact[tags]" value="newsletter,spicex-footer">
            <input type="email" name="contact[email]" placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email' | escape }}" required aria-label="Email address">
            <button type="submit">
              {{ section.settings.newsletter_button | default: 'Join' | escape }}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"/></svg>
            </button>
          {% endif %}
          {%- if form.errors -%}
            <p class="ftr-news-error">{{ form.errors.messages.email }}</p>
          {%- endif -%}
        {% endform %}
      </div>

      {%- comment -%} ===== Link columns from blocks ===== {%- endcomment -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_column' -%}
          <div class="ftr-col" {{ block.shopify_attributes }}>
            <h3 class="ftr-col-heading">{{ block.settings.heading | escape }}</h3>
            <ul>
              {%- if block.settings.link_1_label != blank -%}
                <li><a href="{{ block.settings.link_1_url | default: '#' }}">{{ block.settings.link_1_label | escape }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_2_label != blank -%}
                <li><a href="{{ block.settings.link_2_url | default: '#' }}">{{ block.settings.link_2_label | escape }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_3_label != blank -%}
                <li><a href="{{ block.settings.link_3_url | default: '#' }}">{{ block.settings.link_3_label | escape }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_4_label != blank -%}
                <li><a href="{{ block.settings.link_4_url | default: '#' }}">{{ block.settings.link_4_label | escape }}</a></li>
              {%- endif -%}
              {%- if block.settings.link_5_label != blank -%}
                <li><a href="{{ block.settings.link_5_url | default: '#' }}">{{ block.settings.link_5_label | escape }}</a></li>
              {%- endif -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- comment -%} ===== Social + trust strip ===== {%- endcomment -%}
    <div class="ftr-mid">
      {%- if socials_present -%}
        <div class="ftr-socials">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" class="ftr-social" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tiktok_url != blank -%}
            <a href="{{ section.settings.tiktok_url }}" class="ftr-social" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4 a 5 5 0 0 0 5 5"/><path d="M15 4 V 15 a 4 4 0 1 1 -4 -4"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.youtube_url != blank -%}
            <a href="{{ section.settings.youtube_url }}" class="ftr-social" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="6" width="20" height="12" rx="3"/><path d="M10 9 L 15 12 L 10 15 Z" fill="currentColor"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" class="ftr-social" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M15 4 H 18 V 8 H 15 a 1 1 0 0 0 -1 1 V 12 H 18 L 17 16 H 14 V 22 H 10 V 16 H 7 V 12 H 10 V 8 a 4 4 0 0 1 4 -4 Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.twitter_url != blank -%}
            <a href="{{ section.settings.twitter_url }}" class="ftr-social" target="_blank" rel="noopener" aria-label="X (Twitter)">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4 L 20 20 M 20 4 L 4 20"/></svg>
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.trust_1 != blank or section.settings.trust_2 != blank or section.settings.trust_3 != blank -%}
        <ul class="ftr-trust">
          {%- if section.settings.trust_1 != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>{{ section.settings.trust_1 | escape }}</li>
          {%- endif -%}
          {%- if section.settings.trust_2 != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>{{ section.settings.trust_2 | escape }}</li>
          {%- endif -%}
          {%- if section.settings.trust_3 != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7"/></svg>{{ section.settings.trust_3 | escape }}</li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- comment -%} ===== Bottom bar ===== {%- endcomment -%}
    <div class="ftr-bottom">
      <p class="ftr-copy">{{ section.settings.copyright | default: '© 2026 SpiceX. All rights reserved.' | escape }}</p>
      {%- if section.settings.legal_1_label != blank or section.settings.legal_2_label != blank or section.settings.legal_3_label != blank or section.settings.legal_4_label != blank -%}
        <ul class="ftr-legal">
          {%- if section.settings.legal_1_label != blank -%}
            <li><a href="{{ section.settings.legal_1_url | default: '#' }}">{{ section.settings.legal_1_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.legal_2_label != blank -%}
            <li><a href="{{ section.settings.legal_2_url | default: '#' }}">{{ section.settings.legal_2_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.legal_3_label != blank -%}
            <li><a href="{{ section.settings.legal_3_url | default: '#' }}">{{ section.settings.legal_3_label | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.legal_4_label != blank -%}
            <li><a href="{{ section.settings.legal_4_url | default: '#' }}">{{ section.settings.legal_4_label | escape }}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom footer",
  "class": "spx-footer-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Brand wordmark"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo (replaces the text wordmark)"
    },
    {
      "type": "checkbox",
      "id": "show_wordmark",
      "label": "Show giant brand wordmark",
      "default": true
    },
    {
      "type": "html",
      "id": "wordmark",
      "label": "Wordmark (use <em> for italic accent)",
      "default": "Spice<em>X</em>"
    },
    {
      "type": "header",
      "content": "Brand column"
    },
    {
      "type": "html",
      "id": "tagline",
      "label": "Tagline",
      "default": "Real ingredients. <em>Read the label.</em> Fall in love."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_label",
      "label": "Newsletter label",
      "default": "Get 10% off your first order"
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Your email"
    },
    {
      "type": "text",
      "id": "newsletter_button",
      "label": "Button text",
      "default": "Join"
    },
    {
      "type": "header",
      "content": "Social"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "twitter_url",
      "label": "X (Twitter) URL"
    },
    {
      "type": "header",
      "content": "Trust strip"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust item 1",
      "default": "Free shipping on 2+ jars"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust item 2",
      "default": "30-day money back guarantee"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust item 3",
      "default": "Hand-blended in the USA"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© 2026 SpiceX. All rights reserved."
    },

<style>
.s2-paths__grid{display:grid;gap:14px;max-width:1220px;margin:0 auto;padding:0 14px}
.s2-path{display:flex;flex-direction:column;background:var(--s2-cream);border-radius:var(--s2-r);overflow:hidden;text-decoration:none;color:var(--s2-ink)}
.s2-path__pic{aspect-ratio:3/2;overflow:hidden;background:var(--s2-sand)}
.s2-path__pic img{width:100%;height:100%;object-fit:cover;object-position:50% 50%;display:block;transition:transform .5s ease}
.s2-path__body{padding:20px 22px 24px;display:flex;flex-direction:column;gap:8px;flex:1}
.s2-path__name{font:800 26px/1.08 var(--s2-display);letter-spacing:-.015em;margin:0;color:var(--s2-ink);text-transform:none}
.s2-path__text{font:400 16px/1.45 var(--spx-font-body);color:var(--s2-muted);margin:0;letter-spacing:0}
.s2-path__go{font:700 16px/1 var(--s2-display);color:var(--s2-flame-dk);margin-top:auto;padding-top:10px;text-decoration:underline;text-underline-offset:5px;text-decoration-thickness:2px}
.s2-path:focus-visible{outline:3px solid var(--s2-ink);outline-offset:3px}
@media(hover:hover){.s2-path:hover .s2-path__pic img{transform:scale(1.04)}}
@media(prefers-reduced-motion:reduce){.s2-path__pic img{transition:none}}
@media(min-width:800px){.s2-paths__grid{grid-template-columns:repeat(3,1fr);gap:18px;padding:0 20px}}
</style>
<section class="s2-sec s2-paths">
  <div class="s2-head">
    <h2 class="s2-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="s2-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="s2-paths__grid">
    {%- for block in section.blocks -%}
      <a class="s2-path" href="{{ block.settings.link }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image != blank -%}
          <span class="s2-path__pic">{{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 800px) 390px, 94vw' }}</span>
        {%- endif -%}
        <span class="s2-path__body">
          <h3 class="s2-path__name">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}<p class="s2-path__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.link_label != blank -%}<span class="s2-path__go">{{ block.settings.link_label }}</span>{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "S2 Ways to cook",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Built for how you cook." },
    { "type": "text", "id": "subheading", "label": "Subheading" }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "path", "name": "Card", "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo", "info": "Use a landscape 3:2 photo. The whole photo shows, nothing is cropped." },
    { "type": "text", "id": "title", "label": "Title", "default": "Meal prep" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" }
  ]}],
  "presets": [{ "name": "S2 Ways to cook" }]
}
{% endschema %}

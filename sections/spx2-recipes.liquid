<style>
.s2-rec__grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;max-width:1220px;margin:0 auto;padding:0 14px}
.s2-rec__card{display:flex;flex-direction:column;background:#fff;border:1px solid var(--s2-line);border-radius:var(--s2-r);overflow:hidden;text-decoration:none;color:var(--s2-ink)}
.s2-rec__pic{aspect-ratio:4/3;background:var(--s2-sand);overflow:hidden}
.s2-rec__pic img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease}
.s2-rec__body{padding:14px 16px 18px;display:flex;flex-direction:column;gap:6px}
.s2-rec__kind{font:700 12px/1.2 var(--spx-font-body);letter-spacing:.06em;text-transform:uppercase;color:var(--s2-flame-dk)}
.s2-rec__name{font:800 19px/1.14 var(--s2-display);letter-spacing:-.01em;color:var(--s2-ink)}
.s2-rec__more{text-align:center;margin-top:26px}
.s2-rec__card:focus-visible{outline:3px solid var(--s2-ink);outline-offset:3px}
@media(hover:hover){.s2-rec__card:hover .s2-rec__pic img{transform:scale(1.04)}}
@media(prefers-reduced-motion:reduce){.s2-rec__pic img{transition:none}}
@media(min-width:800px){.s2-rec__grid{grid-template-columns:repeat(4,1fr);gap:16px;padding:0 20px}.s2-rec__name{font-size:21px}}
</style>
<section class="s2-sec s2-rec">
  <div class="s2-head">
    <h2 class="s2-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="s2-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="s2-rec__grid">
    {%- for block in section.blocks -%}
      {%- assign a = block.settings.article -%}
      {%- if a == blank -%}{%- continue -%}{%- endif -%}
      {%- assign blend = '' -%}{%- assign total = '' -%}
      {%- for tag in a.tags -%}
        {%- if tag contains 'blend:' and blend == '' -%}{%- assign blend = tag | remove: 'blend:' | replace: 'Oh Cajun', "Oh' Cajun" -%}
        {%- elsif tag contains 'total:' -%}{%- assign total = tag | remove: 'total:' -%}{%- endif -%}
      {%- endfor -%}
      <a class="s2-rec__card" href="{{ a.url }}" {{ block.shopify_attributes }}>
        <span class="s2-rec__pic">{%- if a.image -%}{{ a.image | image_url: width: 800 | image_tag: loading: 'lazy', alt: a.title, widths: '300, 500, 800', sizes: '(min-width: 800px) 290px, 46vw' }}{%- endif -%}</span>
        <span class="s2-rec__body">
          {%- if blend != '' or total != '' -%}<span class="s2-rec__kind">{{ blend }}{% if blend != '' and total != '' %} · {% endif %}{{ total }}</span>{%- endif -%}
          <span class="s2-rec__name">{{ a.title }}</span>
        </span>
      </a>
    {%- endfor -%}
  </div>
  {%- if section.settings.more_label != blank -%}<p class="s2-rec__more"><a class="s2-link" href="{{ section.settings.more_link }}">{{ section.settings.more_label }}</a></p>{%- endif -%}
</section>
{% schema %}
{
  "name": "S2 Recipes",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Recipes to start with." },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "more_label", "label": "Link label", "default": "See all recipes" },
    { "type": "url", "id": "more_link", "label": "Link" }
  ],
  "max_blocks": 8,
  "blocks": [{ "type": "recipe", "name": "Recipe", "settings": [{ "type": "article", "id": "article", "label": "Recipe" }] }],
  "presets": [{ "name": "S2 Recipes" }]
}
{% endschema %}

<section class="s2-sec s2-steps">
  <div class="s2-head">
    <h2 class="s2-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="s2-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="s2-steps__grid">
    <div class="s2-steps__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '400, 700, 1000', sizes: '(min-width: 800px) 480px, 100vw' }}
      {%- else -%}{{ 'lifestyle-2' | placeholder_svg_tag }}{%- endif -%}
    </div>
    <div>
      <ol class="s2-steps__list">
        {%- for block in section.blocks -%}
          <li class="s2-step" {{ block.shopify_attributes }}>
            <span class="s2-step__n" aria-hidden="true">{{ forloop.index }}</span>
            <div><h3 class="s2-step__t">{{ block.settings.title }}</h3><p class="s2-step__d">{{ block.settings.text }}</p></div>
          </li>
        {%- endfor -%}
      </ol>
      {%- if section.settings.button_label != blank -%}<p class="s2-steps__cta"><a class="s2-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a></p>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "S2 How it works",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Okay, so how does this work?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "It's dinner, minus the part where you guess." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop the blends" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "max_blocks": 4,
  "blocks": [{ "type": "step", "name": "Step", "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Coat it well." },
    { "type": "text", "id": "text", "label": "Text", "default": "Chicken, steak, shrimp, veggies. Be generous." }
  ]}],
  "presets": [{ "name": "S2 How it works" }]
}
{% endschema %}

<style>
.s2-ct__wrap{max-width:620px;margin:0 auto;padding:0 20px}
.s2-ct__form{display:grid;gap:14px}
.s2-ct__form label{display:grid;gap:6px;font:700 15px/1.2 var(--spx-font-body)!important;color:var(--s2-ink);letter-spacing:0!important;text-transform:none!important;margin:0}
.s2-ct__form input,.s2-ct__form textarea{width:100%;box-sizing:border-box;padding:14px 16px;border-radius:16px;border:2px solid var(--s2-line);background:#fff;font:400 17px/1.4 var(--spx-font-body);color:var(--s2-ink);letter-spacing:0}
.s2-ct__form textarea{min-height:150px;resize:vertical}
.s2-ct__form input:focus,.s2-ct__form textarea:focus{outline:3px solid var(--s2-ink);outline-offset:2px}
.s2-ct__note{font:400 16px/1.5 var(--spx-font-body);color:var(--s2-muted);margin:18px 0 0;text-align:center}
.s2-ct__note a{color:var(--s2-ink);font-weight:700}
.s2-ct__msg{border-radius:16px;padding:14px 16px;font:600 16px/1.4 var(--spx-font-body);margin:0 0 6px}
.s2-ct__msg--ok{background:#E3F3E1;color:#17451B}
.s2-ct__msg--err{background:#FCE4DD;color:#7A1F08}
</style>
<section class="s2-sec s2-ct">
  <div class="s2-head">
    <h1 class="s2-h">{{ section.settings.heading }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="s2-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="s2-ct__wrap">
    {%- form 'contact', class: 's2-ct__form' -%}
      {%- if form.posted_successfully? -%}<p class="s2-ct__msg s2-ct__msg--ok" role="status">{{ section.settings.success_text }}</p>{%- endif -%}
      {%- if form.errors -%}<p class="s2-ct__msg s2-ct__msg--err" role="alert">{{ section.settings.error_text }}</p>{%- endif -%}
      <label>{{ section.settings.name_label }}<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
      <label>{{ section.settings.email_label }}<input type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></label>
      <label>{{ section.settings.order_label }}<input type="text" name="contact[order_number]" value=""></label>
      <label>{{ section.settings.message_label }}<textarea name="contact[body]" required>{{ form.body }}</textarea></label>
      <button type="submit" class="s2-btn">{{ section.settings.button_label }}</button>
    {%- endform -%}
    {%- if section.settings.email != blank -%}<p class="s2-ct__note">{{ section.settings.email_text }} <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>{%- endif -%}
  </div>
</section>
{% schema %}
{
  "name": "S2 Contact",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Get in touch." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Questions about an order, a blend or a recipe. Send a message and we will get back to you." },
    { "type": "text", "id": "name_label", "label": "Name label", "default": "Name" },
    { "type": "text", "id": "email_label", "label": "Email label", "default": "Email" },
    { "type": "text", "id": "order_label", "label": "Order number label", "default": "Order number, if you have one" },
    { "type": "text", "id": "message_label", "label": "Message label", "default": "Message" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "text", "id": "success_text", "label": "Text after sending", "default": "Thanks. Your message is in and we will reply by email." },
    { "type": "text", "id": "error_text", "label": "Text when sending fails", "default": "That did not send. Check your email address and try again." },
    { "type": "text", "id": "email_text", "label": "Text before the email address", "default": "Or email us at" },
    { "type": "text", "id": "email", "label": "Email address", "default": "admin@spicexseasoning.com" }
  ],
  "presets": [{ "name": "S2 Contact" }]
}
{% endschema %}

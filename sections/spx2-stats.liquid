<section class="s2-stats">
  <div class="s2-stats__grid">
    {%- for block in section.blocks -%}
      <div {{ block.shopify_attributes }}><span class="s2-stat__n">{{ block.settings.number }}</span><span class="s2-stat__l">{{ block.settings.label }}</span></div>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "S2 Stats band",
  "max_blocks": 4,
  "blocks": [{ "type": "stat", "name": "Stat", "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "4.9" },
    { "type": "text", "id": "label", "label": "Label", "default": "Average rating" }
  ]}],
  "presets": [{ "name": "S2 Stats band" }]
}
{% endschema %}

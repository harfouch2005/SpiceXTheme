{%- comment -%}
  SpiceX Announcement Bar · continuous right-to-left marquee
  - Brand gold #e8a823 background
  - All messages displayed inline, scroll continuously
  - Duplicate set for seamless loop
  - Pause on hover
  - Dismissible per session
  - Respects prefers-reduced-motion (becomes static row)
  - All CSS scoped under #shopify-section-{{ section.id }}
{%- endcomment -%}

{%- liquid
  assign block_count = section.blocks.size
  assign speed = section.settings.scroll_speed | default: 35
-%}

{% style %}
  #shopify-section-{{ section.id }} {
    position: relative;
    width: 100%;
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
    font-family: var(--spx-font-body, 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    line-height: 1.3;
    z-index: 50;
    box-sizing: border-box;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} *,
  #shopify-section-{{ section.id }} *::before,
  #shopify-section-{{ section.id }} *::after { box-sizing: border-box; }

  #shopify-section-{{ section.id }}[hidden] { display: none !important; }

  #shopify-section-{{ section.id }} .spx-ann {
    position: relative;
    width: 100%;
    color: inherit;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .spx-ann__viewport {
    position: relative;
    width: 100%;
    overflow: hidden;
    padding: 12px 0;
    {% if section.settings.dismissible %}padding-right: 44px;{% endif %}
  }

  /* The track holds TWELVE identical lists side by side and moves by exactly one list,
     so the loop never shows a gap, even on very wide screens. */
  #shopify-section-{{ section.id }} .spx-ann__track {
    display: flex;
    width: max-content;
    align-items: center;
    animation: spx-ann-scroll-{{ section.id }} {{ speed }}s linear infinite;
    will-change: transform;
  }
  #shopify-section-{{ section.id }} .spx-ann__viewport:hover .spx-ann__track {
    animation-play-state: paused;
  }

  #shopify-section-{{ section.id }} .spx-ann__list {
    display: flex;
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
    list-style: none;
    margin: 0;
    padding: 0 clamp(20px, 4vw, 56px) 0 0;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .spx-ann__item {
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 4vw, 56px);
  }
  #shopify-section-{{ section.id }} .spx-ann__item a {
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .spx-ann__item a:hover { opacity: 0.78; }

  /* Dot separator between messages */
  #shopify-section-{{ section.id }} .spx-ann__dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.7;
    display: inline-block;
    flex: 0 0 auto;
  }

  /* Close button */
  #shopify-section-{{ section.id }} .spx-ann__close {
    position: absolute;
    top: 50%;
    right: clamp(10px, 2vw, 18px);
    transform: translateY(-50%);
    background: {{ section.settings.background_color }};
    border: 0;
    color: currentColor;
    cursor: pointer;
    padding: 8px;
    line-height: 0;
    opacity: 0.72;
    transition: opacity 0.2s ease;
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .spx-ann__close:hover { opacity: 1; }
  #shopify-section-{{ section.id }} .spx-ann__close svg {
    width: 14px;
    height: 14px;
    display: block;
  }

  @keyframes spx-ann-scroll-{{ section.id }} {
    from { transform: translateX(0); }
    to { transform: translateX(calc(-100% / 12)); }
  }

  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} {
      font-size: 11px;
      letter-spacing: 0.08em;
    }
    #shopify-section-{{ section.id }} .spx-ann__viewport {
      padding: 10px 0;
      {% if section.settings.dismissible %}padding-right: 36px;{% endif %}
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .spx-ann__track {
      animation: none;
      width: 100%;
      justify-content: center;
    }
    /* Hide the duplicate list when motion is reduced */
    #shopify-section-{{ section.id }} .spx-ann__list--duplicate {
      display: none;
    }
  }
{% endstyle %}

{%- if block_count > 0 -%}
  <aside class="spx-ann" role="region" aria-label="Site announcements">
    <div class="spx-ann__viewport">
      <div class="spx-ann__track" data-spx-ann-track>
        {%- for repeat in (1..12) -%}
          <ul class="spx-ann__list{% unless forloop.first %} spx-ann__list--duplicate{% endunless %}" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
            {%- for block in section.blocks -%}
              <li class="spx-ann__item" {% if forloop.parentloop.first %}{{ block.shopify_attributes }}{% endif %}>
                {%- if block.settings.link != blank -%}
                  <a href="{{ block.settings.link }}">{{ block.settings.message | escape }}</a>
                {%- else -%}
                  <span>{{ block.settings.message | escape }}</span>
                {%- endif -%}
                <span class="spx-ann__dot" aria-hidden="true"></span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
    {%- if section.settings.dismissible -%}
      <button type="button" class="spx-ann__close" aria-label="Dismiss announcement" data-spx-ann-close>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18"/>
        </svg>
      </button>
    {%- endif -%}
  </aside>

  <script>
    (function() {
      var section = document.getElementById('shopify-section-{{ section.id }}');
      if (!section) return;

      var storageKey = 'spx-ann-dismissed-{{ section.id }}';
      try {
        if (sessionStorage.getItem(storageKey) === '1') {
          section.setAttribute('hidden', '');
          return;
        }
      } catch (_) {}

      var closeBtn = section.querySelector('[data-spx-ann-close]');
      if (closeBtn) {
        closeBtn.addEventListener('click', function() {
          section.setAttribute('hidden', '');
          try { sessionStorage.setItem(storageKey, '1'); } catch (_) {}
        });
      }
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "SpiceX announcement",
  "class": "spx-ann-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#e8a823"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Behavior"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Dismissible (per session)",
      "default": true
    },
    {
      "type": "range",
      "id": "scroll_speed",
      "label": "Scroll duration",
      "info": "Seconds for one full loop. Lower = faster scroll.",
      "min": 20,
      "max": 90,
      "step": 5,
      "default": 35,
      "unit": "s"
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "message",
          "label": "Message",
          "default": "Free shipping on orders $35+"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      {
        "type": "message",
        "settings": {
          "message": "30-day money back guarantee"
        }
      },
      {
        "type": "message",
        "settings": {
          "message": "Free Shipping On Orders $35+"
        }
      },
      {
        "type": "message",
        "settings": {
          "message": "All-Natural · Non-GMO · No Fillers"
        }
      },
      {
        "type": "message",
        "settings": {
          "message": "Hand-Blended In Small Batches"
        }
      }
    ]
  }
}
{% endschema %}

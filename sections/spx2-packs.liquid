<style>
.s2-pack{position:relative}
.s2-pack__copy{display:contents}
.s2-pack__badge{position:absolute;top:14px;left:14px;background:var(--s2-ink);color:#fff;font:700 13px/1 var(--spx-font-body);letter-spacing:0;padding:8px 13px;border-radius:999px}
.s2-pack--wide{padding-top:54px}
.s2-pack__pick{display:grid;grid-template-columns:repeat(3,var(--sw,78px));gap:8px;justify-content:center;margin-bottom:20px}
.s2-slot{aspect-ratio:3/4;border-radius:14px;background:#fff;display:block;overflow:hidden;padding:9% 6%;box-sizing:border-box}
.s2-slot img{display:block;width:100% !important;height:100% !important;max-width:none;object-fit:contain;object-position:center;margin:0;filter:drop-shadow(0 4px 6px rgba(22,18,14,.16))}
.s2-slot--open{display:grid;place-items:center;padding:0;background:transparent;border:2px dashed var(--s2-flame);color:var(--s2-flame);font:800 30px/1 var(--s2-display)}
.s2-pack--wide .s2-pack__fan{--h:118px;--o:12px}
.s2-pack--wide .s2-pack__blurb{max-width:36ch}
@media(min-width:800px){
  .s2-pack--wide{grid-column:1 / -1;flex-direction:row;align-items:center;text-align:left;gap:44px;padding:34px 48px}
  .s2-pack--wide .s2-pack__fan{--h:200px;--o:18px;margin:0 10px 0 0;flex:0 0 auto}
  .s2-pack--wide .s2-pack__pick{--sw:96px;gap:10px;margin:0 10px 0 0;flex:0 0 auto}
  .s2-pack--wide .s2-pack__copy{display:flex;flex-direction:column;align-items:flex-start;flex:1 1 auto}
  .s2-pack--wide .s2-pack__name{font-size:34px}
  .s2-pack--wide .s2-pack__blurb{max-width:48ch;font-size:17px}
  .s2-pack--wide .s2-btn{width:auto;max-width:none;margin-top:0}
  .s2-pack--wide .s2-pack__badge{top:18px;left:auto;right:18px}
}
</style>
<section class="s2-sec s2-packs">
  <div class="s2-head">
    <h2 class="s2-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="s2-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  <div class="s2-packs__grid">
    {%- for block in section.blocks -%}
      {%- assign list = block.settings.products -%}
      {%- assign cart_product = block.settings.cart_product -%}
      {%- capture ids -%}{%- if cart_product != blank -%}{{ cart_product.selected_or_first_available_variant.id }}{%- else -%}{%- for p in list -%}{{ p.selected_or_first_available_variant.id }}{% unless forloop.last %},{% endunless %}{%- endfor -%}{%- endif -%}{%- endcapture -%}
      <article class="s2-pack{% if block.settings.featured %} s2-pack--wide{% endif %}" {{ block.shopify_attributes }}>
        {%- if block.settings.badge != blank -%}<span class="s2-pack__badge">{{ block.settings.badge }}</span>{%- endif -%}
        {%- if block.settings.pick -%}
        <div class="s2-pack__pick" role="img" aria-label="{{ block.settings.pick_label | escape }}">
          {%- for p in list -%}
            {%- assign odd = forloop.index0 | modulo: 2 -%}
            {%- if odd == 0 -%}<span class="s2-slot">{%- render 'spx2-jar', p: p, alt: '', size: 300, sizes: '90px' -%}</span>
            {%- else -%}<span class="s2-slot s2-slot--open"><span>+</span></span>{%- endif -%}
          {%- endfor -%}
        </div>
        {%- else -%}
        <div class="s2-pack__fan"{% if list.size > 4 and block.settings.featured != true %} style="--h:118px;--o:12px"{% endif %}>
          {%- for p in list -%}
            {%- render 'spx2-jar', p: p, alt: p.title, size: 400, sizes: '120px' -%}
          {%- endfor -%}
        </div>
        {%- endif -%}
        <div class="s2-pack__copy">
        <h3 class="s2-pack__name">{{ block.settings.title }}</h3>
        {%- if block.settings.blurb != blank -%}<p class="s2-pack__blurb">{{ block.settings.blurb }}</p>{%- endif -%}
        <p class="s2-pack__note">{% if cart_product != blank %}{{ cart_product.price | money }}{% if block.settings.note != blank %} · {% endif %}{% endif %}{{ block.settings.note }}</p>
        {%- if block.settings.link != blank -%}
          <a class="s2-btn" href="{{ block.settings.link }}">{{ block.settings.button_label }}</a>
        {%- else -%}
          <button type="button" class="s2-btn" data-s2-pack="{{ ids | strip }}" data-s2-busy="{{ section.settings.busy_label | escape }}" data-s2-fail="{{ section.settings.fail_label | escape }}">{{ block.settings.button_label }}</button>
        {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
  {%- if section.settings.more_label != blank -%}
    <p class="s2-packs__more"><a class="s2-link" href="{{ section.settings.more_link }}">{{ section.settings.more_label }}</a></p>
  {%- endif -%}
</section>
<script>
  (function(){
    document.querySelectorAll('[data-s2-pack]').forEach(function(btn){
      if (btn.dataset.s2Bound) return;
      btn.dataset.s2Bound = '1';
      btn.addEventListener('click', function(){
        var ids = (btn.getAttribute('data-s2-pack') || '').split(',').filter(Boolean);
        if (!ids.length) return;
        var label = btn.textContent;
        btn.disabled = true;
        btn.textContent = btn.getAttribute('data-s2-busy') || label;
        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({ items: ids.map(function(id){ return { id: Number(id), quantity: 1 }; }) })
        }).then(function(r){
          if (!r.ok) throw new Error('add failed');
          window.location.href = '{{ routes.cart_url }}';
        }).catch(function(){
          btn.disabled = false;
          btn.textContent = btn.getAttribute('data-s2-fail') || label;
        });
      });
    });
  })();
</script>
{% schema %}
{
  "name": "S2 Starter packs",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New here? Start with a set." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Three easy ways in. One tap adds the whole set to your cart." },
    { "type": "text", "id": "more_label", "label": "Link label", "default": "Or build your own box" },
    { "type": "url", "id": "more_link", "label": "Link" },
    { "type": "text", "id": "busy_label", "label": "Button text while adding", "default": "Adding" },
    { "type": "text", "id": "fail_label", "label": "Button text if adding fails", "default": "Try again" }
  ],
  "max_blocks": 4,
  "blocks": [{
    "type": "pack", "name": "Pack",
    "settings": [
      { "type": "text", "id": "title", "label": "Name", "default": "Weeknight Trio" },
      { "type": "text", "id": "blurb", "label": "Description" },
      { "type": "product_list", "id": "products", "label": "Jars shown (and added, unless a single product is set below)", "limit": 6 },
      { "type": "product", "id": "cart_product", "label": "Single product to add instead (optional)" },
      { "type": "text", "id": "note", "label": "Note under description", "default": "Save $5 on any 3 jars" },
      { "type": "text", "id": "button_label", "label": "Button label", "default": "Add the trio" },
      { "type": "url", "id": "link", "label": "Button goes to a page instead of adding to cart (optional)" },
      { "type": "text", "id": "badge", "label": "Badge (optional)" },
      { "type": "checkbox", "id": "featured", "label": "Wide card across the top", "default": false },
      { "type": "checkbox", "id": "pick", "label": "Show as a pick-your-own tray (every other slot open)", "default": false },
      { "type": "text", "id": "pick_label", "label": "Tray description for screen readers", "default": "A box with three jars picked and three open slots" }
    ]
  }],
  "presets": [{ "name": "S2 Starter packs" }]
}
{% endschema %}

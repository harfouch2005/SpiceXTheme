{%- comment -%}
  SpiceX PDP · Featured testimonial slab (large pull quote)
{%- endcomment -%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#f7f3ec' }};
    color: #0a0a0a;
    font-family: var(--spx-font-body);
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .pdp-tm {
    max-width: 880px;
    margin: 0 auto;
    padding: 80px clamp(20px, 4vw, 56px);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .pdp-tm-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #6b6b6b;
    margin: 0 0 24px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .pdp-tm-eyebrow::before,
  #shopify-section-{{ section.id }} .pdp-tm-eyebrow::after { content: ''; width: 20px; height: 1px; background: #6b6b6b; }
  #shopify-section-{{ section.id }} .pdp-tm-quote {
    font-family: var(--spx-font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.2;
    color: #0a0a0a;
    margin: 0 0 20px;
    letter-spacing: -0.018em;
    font-variation-settings: "WONK" 0, "SOFT" 50, "opsz" 144;
  }
  #shopify-section-{{ section.id }} .pdp-tm-stars {
    color: #f5b316;
    font-size: 14px;
    letter-spacing: 0.05em;
    margin: 0 0 8px;
    line-height: 1;
  }
  #shopify-section-{{ section.id }} .pdp-tm-author {
    font-size: 13px;
    color: #6b6b6b;
    margin: 0;
  }
  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .pdp-tm { padding: 56px 20px; }
  }
{% endstyle %}

<section class="pdp-tm">
  {%- if section.settings.eyebrow != blank -%}<p class="pdp-tm-eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
  <p class="pdp-tm-quote">"{{ section.settings.quote | default: 'I bought this for myself. Now I buy it as a housewarming gift.' | escape }}"</p>
  <p class="pdp-tm-stars" aria-hidden="true">★★★★★</p>
  <p class="pdp-tm-author">{{ section.settings.author | default: 'Marcus T. · Chicago, IL' | escape }}</p>
</section>

{% schema %}
{
  "name": "PDP · Testimonial",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why People Come Back" },
    { "type": "textarea", "id": "quote", "label": "Quote", "default": "I bought this for myself. Now I buy it as a housewarming gift." },
    { "type": "text", "id": "author", "label": "Author + location", "default": "Marcus T. · Chicago, IL" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f7f3ec" }
  ],
  "presets": [{ "name": "PDP · Testimonial", "category": "Product" }]
}
{% endschema %}

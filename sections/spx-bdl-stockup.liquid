{%- comment -%}
  SpiceX Bundle PDP · Build Your Own Bundle (mix & match, NO cap, auto tier pricing)
  - Add any number of any jars (Bella included); 3 unlocks the 3-Jar deal, 6 unlocks the 6-Jar deal
  - 4/5/7+ allowed at real per-jar pricing (each card carries its own product price)
  - Sticky summary + Add-to-Cart bar · always reachable, no scrolling to find it
{%- endcomment -%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap">

{% style %}
  #shopify-section-{{ section.id }} {
    --bg: {{ section.settings.bg_color | default: '#fbf8f2' }};
    --bg-coupon: #f7f3ec;
    --ink: #0a0a0a;
    --ink-mute: #555555;
    --ink-dim: #999999;
    --line: rgba(10, 10, 10, 0.10);
    --line-strong: rgba(10, 10, 10, 0.18);
    --gold: {{ section.settings.gold | default: '#f5b316' }};
    --success: #2a7a3a;
    background: var(--bg);
    color: var(--ink);
    font-family: var(--spx-font-body);
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} *, #shopify-section-{{ section.id }} *::before, #shopify-section-{{ section.id }} *::after { box-sizing: border-box; }

  #shopify-section-{{ section.id }} .byo { max-width: 1200px; margin: 0 auto; padding: 80px clamp(20px, 4vw, 56px); }
  #shopify-section-{{ section.id }} .byo-head { text-align: center; max-width: 720px; margin: 0 auto 24px; }
  #shopify-section-{{ section.id }} .byo-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--gold); margin: 0 0 12px; line-height: 1;
  }
  #shopify-section-{{ section.id }} .byo-eyebrow::before { content: ''; width: 24px; height: 1px; background: var(--gold); }
  #shopify-section-{{ section.id }} .byo-title {
    font-family: var(--spx-font-display); font-weight: 500;
    font-size: clamp(32px, 3.6vw, 48px); letter-spacing: -0.025em; color: var(--ink); line-height: 1.05; margin: 0 0 8px;
    font-variation-settings: "WONK" 0, "SOFT" 30, "opsz" 144;
  }
  #shopify-section-{{ section.id }} .byo-sub { font-family: var(--spx-font-display); font-style: italic; font-size: 17px; color: var(--ink-mute); margin: 0; line-height: 1.45; }

  /* TIER TRACKER */
  #shopify-section-{{ section.id }} .byo-tiers { display: flex; justify-content: center; gap: 12px; margin: 28px auto 0; max-width: 860px; flex-wrap: wrap; }
  #shopify-section-{{ section.id }} .byo-tier {
    flex: 1 1 calc(25% - 9px); min-width: 150px; background: var(--bg-coupon);
    border: 2px dashed var(--line-strong); border-radius: 12px; padding: 14px 12px; text-align: center;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }
  #shopify-section-{{ section.id }} .byo-tier.is-active { border-style: solid; border-color: var(--gold); background: color-mix(in srgb, var(--gold) 12%, var(--bg-coupon)); transform: translateY(-2px); }
  #shopify-section-{{ section.id }} .byo-tier-qty { font-size: 10.5px; font-weight: 800; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-mute); margin: 0 0 4px; line-height: 1; }
  #shopify-section-{{ section.id }} .byo-tier-price { font-family: var(--spx-font-display); font-weight: 600; font-size: 24px; color: var(--ink); line-height: 1; letter-spacing: -0.02em; margin: 0 0 4px; }
  #shopify-section-{{ section.id }} .byo-tier-save { font-size: 12px; font-weight: 600; color: var(--success); margin: 0; }

  #shopify-section-{{ section.id }} .byo-select-label { text-align: center; margin: 36px 0 20px; font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink-mute); line-height: 1; }

  /* STICKY SUMMARY + ATC BAR */
  #shopify-section-{{ section.id }} .byo-bar {
    position: sticky; top: 76px; z-index: 20;
    margin: 0 auto 24px; max-width: 720px;
    background: #ffffff; border: 1px solid var(--line); border-radius: 14px;
    box-shadow: 0 14px 32px -16px rgba(0,0,0,0.22);
    padding: 14px 16px; display: flex; align-items: center; gap: 14px;
  }
  #shopify-section-{{ section.id }} .byo-bar-info { flex: 1; min-width: 0; }
  #shopify-section-{{ section.id }} .byo-bar-count { font-family: var(--spx-font-display); font-weight: 600; font-size: 18px; color: var(--ink); line-height: 1.1; letter-spacing: -0.01em; font-variation-settings: "WONK" 0, "SOFT" 30; }
  #shopify-section-{{ section.id }} .byo-bar-count .byo-bar-price { color: var(--gold); }
  #shopify-section-{{ section.id }} .byo-bar-note { font-size: 12.5px; color: var(--ink-mute); margin-top: 3px; line-height: 1.3; }
  #shopify-section-{{ section.id }} .byo-bar-note.is-deal { color: var(--success); font-weight: 600; }
  #shopify-section-{{ section.id }} .byo-bar-btn {
    flex: 0 0 auto; background: var(--ink); color: #ffffff; border: 0; border-radius: 100px;
    padding: 0 26px; height: 54px; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase;
    cursor: pointer; line-height: 1; display: inline-flex; align-items: center; gap: 8px;
    transition: background 0.25s ease, transform 0.2s ease, opacity 0.25s ease; max-width: 60%;
  }
  #shopify-section-{{ section.id }} .byo-bar-btn:not(:disabled):hover { background: var(--gold); color: var(--ink); transform: translateY(-2px); }
  #shopify-section-{{ section.id }} .byo-bar-btn:disabled { background: #cccccc; color: #777; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .byo-bar-btn.is-deal { background: var(--gold); color: var(--ink); }
  #shopify-section-{{ section.id }} .byo-bar-btn .byo-spin { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.4); border-top-color: #fff; border-radius: 50%; animation: byo-spin 0.7s linear infinite; }
  @keyframes byo-spin { to { transform: rotate(360deg); } }

  /* PICKER GRID */
  #shopify-section-{{ section.id }} .byo-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  #shopify-section-{{ section.id }} .byo-card {
    --c: #0099d6; --c-soft: #e6f4fb; position: relative; background: #ffffff;
    border: 1px solid var(--line); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  #shopify-section-{{ section.id }} .byo-card.is-on { border: 2px solid var(--c); background: var(--c-soft); }
  #shopify-section-{{ section.id }} .byo-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: var(--c); z-index: 2; }
  #shopify-section-{{ section.id }} .byo-card.is-on::before { height: 0; }
  #shopify-section-{{ section.id }} .byo-img-wrap { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: radial-gradient(ellipse at center, color-mix(in srgb, var(--c) 12%, transparent) 0%, transparent 65%); }
  #shopify-section-{{ section.id }} .byo-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; padding: 24px; }
  #shopify-section-{{ section.id }} .byo-qty-badge {
    position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border-radius: 50%;
    background: var(--c); color: #fff; display: flex; align-items: center; justify-content: center;
    font-size: 13px; font-weight: 800; z-index: 2; box-shadow: 0 6px 14px -4px rgba(0,0,0,0.2);
    opacity: 0; transform: scale(0.6); transition: opacity 0.2s ease, transform 0.2s cubic-bezier(0.22,1,0.36,1);
  }
  #shopify-section-{{ section.id }} .byo-qty-badge.is-on { opacity: 1; transform: scale(1); }
  #shopify-section-{{ section.id }} .byo-body { padding: 18px 20px 20px; display: flex; flex-direction: column; gap: 4px; }
  #shopify-section-{{ section.id }} .byo-cat { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--c); margin: 0; line-height: 1; }
  #shopify-section-{{ section.id }} .byo-name { font-family: var(--spx-font-display); font-weight: 600; font-size: 22px; color: var(--ink); margin: 4px 0 0; letter-spacing: -0.018em; line-height: 1.1; font-variation-settings: "WONK" 0, "SOFT" 30; }
  #shopify-section-{{ section.id }} .byo-meta { font-size: 12.5px; font-weight: 500; color: var(--ink-mute); margin: 4px 0 0; }
  #shopify-section-{{ section.id }} .byo-stepper { display: flex; align-items: center; gap: 8px; margin-top: 12px; }
  #shopify-section-{{ section.id }} .byo-step { height: 40px; border: 1.5px solid var(--ink); background: #fff; color: var(--ink); border-radius: 8px; cursor: pointer; font-family: var(--spx-font-body); font-weight: 700; line-height: 1; transition: background 0.2s ease, color 0.2s ease, border-color 0.2s ease, opacity 0.2s ease; }
  #shopify-section-{{ section.id }} .byo-step--minus { width: 40px; font-size: 18px; flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .byo-step--add { flex: 1; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; }
  #shopify-section-{{ section.id }} .byo-step--add:hover { background: var(--c); color: #fff; border-color: var(--c); }
  #shopify-section-{{ section.id }} .byo-step--minus:not(:disabled):hover { background: var(--ink); color: #fff; }
  #shopify-section-{{ section.id }} .byo-step:disabled { opacity: 0.3; cursor: not-allowed; }
  #shopify-section-{{ section.id }} .byo-step-count { min-width: 22px; text-align: center; font-family: var(--spx-font-display); font-weight: 600; font-size: 18px; color: var(--ink); flex: 0 0 auto; }
  #shopify-section-{{ section.id }} .byo-card.is-on .byo-step-count { color: var(--c); }

  #shopify-section-{{ section.id }} .byo-trust { text-align: center; margin: 24px 0 0; font-size: 12px; font-weight: 500; color: var(--ink-mute); line-height: 1.5; }
  #shopify-section-{{ section.id }} .byo-trust .sep { color: var(--ink-dim); margin: 0 6px; }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .byo { padding: 56px 20px; }
    #shopify-section-{{ section.id }} .byo-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    #shopify-section-{{ section.id }} .byo-tiers { gap: 8px; }
    #shopify-section-{{ section.id }} .byo-tier { flex: 1 1 calc(50% - 4px); min-width: 0; padding: 11px 8px; }
    #shopify-section-{{ section.id }} .byo-tier-price { font-size: 19px; }
    #shopify-section-{{ section.id }} .byo-tier-qty { font-size: 10px; }
    #shopify-section-{{ section.id }} .byo-tier-save { font-size: 11px; }
    #shopify-section-{{ section.id }} .byo-bar { position: sticky; top: auto; bottom: 12px; flex-direction: column; align-items: stretch; gap: 10px; padding: 14px; max-width: 100%; }
    #shopify-section-{{ section.id }} .byo-bar-info { text-align: center; }
    #shopify-section-{{ section.id }} .byo-bar-btn { max-width: 100%; width: 100%; justify-content: center; height: 52px; }
  }
{% endstyle %}

{%- liquid
  assign t1_qty = section.settings.tier1_qty | default: 3
  assign t2_qty = section.settings.tier2_qty | default: 4
  assign t3_qty = section.settings.tier3_qty | default: 5
  assign t4_qty = section.settings.tier4_qty | default: 6
-%}

<section class="byo">
  <header class="byo-head">
    <p class="byo-eyebrow">{{ section.settings.eyebrow | default: 'Build Your Own Bundle' | escape }}</p>
    <h2 class="byo-title">{{ section.settings.headline | default: 'Mix & match. Save more.' | escape }}</h2>
    <p class="byo-sub">{{ section.settings.sub | default: 'Build your own bundle · every jar you add unlocks a bigger discount, all the way up to 6. Doubles welcome.' | escape }}</p>
  </header>

  <div class="byo-tiers" aria-hidden="true">
    <div class="byo-tier" data-byo-tier="{{ t1_qty }}">
      <p class="byo-tier-qty">{{ t1_qty }} Jars</p>
      <p class="byo-tier-price">{{ section.settings.tier1_price | default: '$33.99' | escape }}</p>
      <p class="byo-tier-save">{{ section.settings.tier1_save_label | default: 'Save $4.98' | escape }}</p>
    </div>
    <div class="byo-tier" data-byo-tier="{{ t2_qty }}">
      <p class="byo-tier-qty">{{ t2_qty }} Jars</p>
      <p class="byo-tier-price">{{ section.settings.tier2_price | default: '$45.96' | escape }}</p>
      <p class="byo-tier-save">{{ section.settings.tier2_save_label | default: 'Save $6.00' | escape }}</p>
    </div>
    <div class="byo-tier" data-byo-tier="{{ t3_qty }}">
      <p class="byo-tier-qty">{{ t3_qty }} Jars</p>
      <p class="byo-tier-price">{{ section.settings.tier3_price | default: '$57.95' | escape }}</p>
      <p class="byo-tier-save">{{ section.settings.tier3_save_label | default: 'Save $7.00' | escape }}</p>
    </div>
    <div class="byo-tier" data-byo-tier="{{ t4_qty }}">
      <p class="byo-tier-qty">{{ t4_qty }} Jars</p>
      <p class="byo-tier-price">{{ section.settings.tier4_price | default: '$64.99' | escape }}</p>
      <p class="byo-tier-save">{{ section.settings.tier4_save_label | default: 'Save $12.95' | escape }}</p>
    </div>
  </div>

  <p class="byo-select-label">{{ section.settings.select_label | default: 'Pick your jars · add as many as you like' | escape }}</p>

  <div class="byo-bar" data-byo-bar>
    <div class="byo-bar-info">
      <p class="byo-bar-count" data-byo-count>0 jars selected</p>
      <p class="byo-bar-note" data-byo-note>The more you add, the more you save · 3, 4, 5 or 6 jars each unlock a bigger deal.</p>
    </div>
    <button type="button" class="byo-bar-btn" data-byo-atc disabled aria-disabled="true">
      <span data-byo-btn-text>Add jars to continue</span>
    </button>
  </div>

  <div class="byo-grid" aria-label="Choose your jars">
    {%- for block in section.blocks -%}
      {%- assign bp = block.settings.product -%}
      {%- assign bvariant = bp.selected_or_first_available_variant.id -%}
      {%- assign bprice = bp.price | default: 1299 -%}
      {%- assign bimg = block.settings.image -%}
      {%- if bimg == blank and bp != blank -%}{%- assign bimg = bp.featured_image -%}{%- endif -%}
      <div class="byo-card" data-byo-card data-variant-id="{{ bvariant }}" data-price="{{ bprice }}" data-name="{{ block.settings.name | default: bp.title | escape }}"
        style="--c: {{ block.settings.accent_color | default: '#0099d6' }}; --c-soft: {{ block.settings.accent_soft | default: '#e6f4fb' }};" {{ block.shopify_attributes }}>
        <span class="byo-img-wrap">
          {%- if bimg != blank -%}
            <img class="byo-img" src="{{ bimg | image_url: width: 500 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
          {%- endif -%}
          <span class="byo-qty-badge" data-byo-badge aria-hidden="true">×0</span>
        </span>
        <span class="byo-body">
          <span class="byo-cat">{{ block.settings.category | escape }}</span>
          <span class="byo-name">{{ block.settings.name | default: bp.title | escape }}</span>
          <span class="byo-meta">{{ block.settings.meta | default: '5 oz · $12.99 each' | escape }}</span>
          <span class="byo-stepper">
            <button type="button" class="byo-step byo-step--minus" data-byo-step="-1" aria-label="Remove one {{ block.settings.name | escape }}" disabled>−</button>
            <span class="byo-step-count" data-byo-card-count>0</span>
            <button type="button" class="byo-step byo-step--add" data-byo-step="1" aria-label="Add one {{ block.settings.name | escape }}">Add +</button>
          </span>
        </span>
      </div>
    {%- endfor -%}
  </div>

  <p class="byo-trust">
    ✓ Free shipping on 2+ <span class="sep">·</span> ✓ Ships in 1 day from Denver <span class="sep">·</span> ✓ 30-day money back guarantee
  </p>
</section>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;

    var TIERS = [
      { qty: {{ section.settings.tier1_qty | default: 3 }}, price: {{ section.settings.tier1_price | default: '$33.99' | json }}, save: {{ section.settings.tier1_save_amount | default: '$4.98' | json }} },
      { qty: {{ section.settings.tier2_qty | default: 4 }}, price: {{ section.settings.tier2_price | default: '$45.96' | json }}, save: {{ section.settings.tier2_save_amount | default: '$6.00' | json }} },
      { qty: {{ section.settings.tier3_qty | default: 5 }}, price: {{ section.settings.tier3_price | default: '$57.95' | json }}, save: {{ section.settings.tier3_save_amount | default: '$7.00' | json }} },
      { qty: {{ section.settings.tier4_qty | default: 6 }}, price: {{ section.settings.tier4_price | default: '$64.99' | json }}, save: {{ section.settings.tier4_save_amount | default: '$12.95' | json }} }
    ].sort(function(a, b) { return a.qty - b.qty; });
    var MIN_TIER = TIERS[0], MAX_TIER = TIERS[TIERS.length - 1];
    function tierFor(n) { for (var i = 0; i < TIERS.length; i++) { if (TIERS[i].qty === n) return TIERS[i]; } return null; }
    function nextTier(n) { for (var i = 0; i < TIERS.length; i++) { if (TIERS[i].qty > n) return TIERS[i]; } return null; }

    var cards = section.querySelectorAll('[data-byo-card]');
    var countEl = section.querySelector('[data-byo-count]');
    var noteEl = section.querySelector('[data-byo-note]');
    var atc = section.querySelector('[data-byo-atc]');
    var btnText = section.querySelector('[data-byo-btn-text]');
    var tierEls = section.querySelectorAll('[data-byo-tier]');

    var counts = [], prices = [];
    cards.forEach(function(card) {
      counts.push(0);
      prices.push(parseInt(card.getAttribute('data-price'), 10) || 1299);
    });

    function total() { return counts.reduce(function(a, b) { return a + b; }, 0); }
    function subtotalCents() {
      var s = 0;
      for (var i = 0; i < counts.length; i++) s += counts[i] * prices[i];
      return s;
    }
    function money(cents) { return '$' + (cents / 100).toFixed(2); }

    function render() {
      var t = total();

      cards.forEach(function(card, i) {
        var q = counts[i];
        var badge = card.querySelector('[data-byo-badge]');
        var cc = card.querySelector('[data-byo-card-count]');
        var minus = card.querySelector('[data-byo-step="-1"]');
        if (cc) cc.textContent = q;
        if (badge) { badge.textContent = '×' + q; badge.classList.toggle('is-on', q > 0); }
        card.classList.toggle('is-on', q > 0);
        if (minus) minus.disabled = q === 0;
      });

      tierEls.forEach(function(el) {
        var tq = parseInt(el.getAttribute('data-byo-tier'), 10);
        el.classList.toggle('is-active', t === tq);
      });

      var note, isDeal = false, btn;
      var exact = tierFor(t);
      if (t === 0) {
        countEl.textContent = '0 jars selected';
        note = 'Add ' + MIN_TIER.qty + ' to save ' + MIN_TIER.save + ' · up to ' + MAX_TIER.qty + ' for ' + MAX_TIER.price + ' (save ' + MAX_TIER.save + ')';
        btn = 'Add jars to continue';
      } else if (exact) {
        isDeal = true;
        countEl.innerHTML = exact.qty + ' jars · <span class="byo-bar-price">' + exact.price + '</span>';
        note = '🎉 ' + exact.qty + '-Jar deal unlocked · you save ' + exact.save;
        btn = 'Add ' + exact.qty + '-Jar Bundle · ' + exact.price;
      } else {
        var raw = money(subtotalCents());
        countEl.innerHTML = t + (t === 1 ? ' jar' : ' jars') + ' · ' + raw;
        var nt = nextTier(t);
        if (nt) {
          var diff = nt.qty - t;
          note = 'Add ' + diff + (diff === 1 ? ' more jar' : ' more jars') + ' for the ' + nt.qty + '-Jar deal · ' + nt.price + ' (save ' + nt.save + ')';
        } else {
          note = 'Biggest deal is ' + MAX_TIER.qty + ' jars for ' + MAX_TIER.price + ' · you have ' + t;
        }
        btn = 'Add ' + t + (t === 1 ? ' jar' : ' jars') + ' · ' + raw;
      }

      if (noteEl) { noteEl.textContent = note; noteEl.classList.toggle('is-deal', isDeal); }
      if (btnText) btnText.textContent = btn;
      if (atc) {
        atc.disabled = t === 0;
        atc.setAttribute('aria-disabled', t === 0 ? 'true' : 'false');
        atc.classList.toggle('is-deal', isDeal);
      }
    }

    cards.forEach(function(card, i) {
      card.querySelectorAll('[data-byo-step]').forEach(function(btn) {
        btn.addEventListener('click', function() {
          var step = parseInt(btn.getAttribute('data-byo-step'), 10);
          if (step < 0 && counts[i] === 0) return;
          counts[i] = Math.max(0, counts[i] + step);
          render();
        });
      });
    });

    if (atc) {
      atc.addEventListener('click', function() {
        if (total() === 0 || atc.disabled) return;
        var items = [];
        cards.forEach(function(card, i) {
          if (counts[i] > 0) items.push({ id: parseInt(card.getAttribute('data-variant-id'), 10), quantity: counts[i] });
        });
        if (!items.length) return;
        atc.disabled = true;
        if (btnText) btnText.innerHTML = '<span class="byo-spin" aria-hidden="true" style="display:inline-block;vertical-align:middle;margin-right:8px;"></span>Adding…';
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ items: items }) })
          .then(function(r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
          .then(function() { return fetch('/cart.js'); })
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            window.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
            if (btnText) btnText.textContent = '✓ Added to cart';
            setTimeout(function() { counts = counts.map(function() { return 0; }); render(); }, 1600);
          })
          .catch(function(err) { console.error(err); render(); });
      });
    }

    render();
  })();
</script>

{% schema %}
{
  "name": "Build Your Own Bundle",
  "max_blocks": 10,

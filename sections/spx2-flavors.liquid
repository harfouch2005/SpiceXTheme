<section class="s2-sec s2-flavors" id="flavors">
  {%- if section.settings.heading != blank -%}
  <div class="s2-head">
    <h2 class="s2-h">{{ section.settings.heading }}</h2>
    {%- if section.settings.subheading != blank -%}<p class="s2-sub">{{ section.settings.subheading }}</p>{%- endif -%}
  </div>
  {%- endif -%}
  <div class="s2-flavors__grid">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p == blank -%}{%- continue -%}{%- endif -%}
      {%- if product and p.handle == product.handle -%}{%- continue -%}{%- endif -%}
      <article class="s2-flavor" style="--bg:{{ block.settings.bg }};--fg:{{ block.settings.fg }}" {{ block.shopify_attributes }}>
        <span class="s2-flavor__img">{%- render 'spx2-jar', p: p, alt: '', size: 600 -%}</span>
        <h3 class="s2-flavor__name"><a href="{{ p.url }}">{{ p.title }}</a></h3>
        {%- if block.settings.descriptor != blank -%}<p class="s2-flavor__desc">{{ block.settings.descriptor }}</p>{%- endif -%}
        {%- assign f_num = p.metafields.loox.num_reviews.value | default: p.metafields.loox.num_reviews -%}{%- assign f_avg = p.metafields.loox.avg_rating.value | default: p.metafields.loox.avg_rating -%}
        {%- if f_num != blank and f_avg != blank -%}<p class="s2-flavor__rate">★ {{ f_avg }} ({{ f_num }})</p>{%- endif -%}
        {%- if block.settings.tagline != blank -%}<p class="s2-flavor__tag">{{ block.settings.tagline }}</p>{%- endif -%}
        <div class="s2-flavor__foot">
          <span class="s2-flavor__price">{{ p.price | money }}</span>
          {%- if p.available -%}
            <form method="post" action="{{ routes.cart_add_url }}">
              <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
              <button type="submit" class="s2-flavor__add" aria-label="{{ section.settings.add_label }}: {{ p.title }}">{{ section.settings.add_label }}</button>
            </form>
          {%- else -%}
            <span class="s2-flavor__desc">{{ section.settings.soldout_label }}</span>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{
  "name": "S2 Flavor lineup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pick your flavor." },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Six blends. That's the whole lineup, and every one earns its spot." },
    { "type": "text", "id": "add_label", "label": "Add button label", "default": "Add" },
    { "type": "text", "id": "soldout_label", "label": "Sold out label", "default": "Sold out" }
  ],
  "max_blocks": 12,
  "blocks": [{ "type": "flavor", "name": "Flavor", "settings": [
    { "type": "product", "id": "product", "label": "Product" },
    { "type": "text", "id": "descriptor", "label": "Descriptor" },
    { "type": "text", "id": "tagline", "label": "Tagline (desktop)" },
    { "type": "color", "id": "bg", "label": "Tile color", "default": "#4D5057" },
    { "type": "color", "id": "fg", "label": "Text color", "default": "#FFFFFF" }
  ]}],
  "presets": [{ "name": "S2 Flavor lineup" }]
}
{% endschema %}

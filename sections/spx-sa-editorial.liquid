{%- comment -%}
  Shop All · Editorial single-line moment
{%- endcomment -%}

{% style %}
  #shopify-section-{{ section.id }} {
    background: {{ section.settings.bg_color | default: '#f7f3ec' }};
    color: #0a0a0a;
    font-family: var(--spx-font-display);
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .sa-ed {
    max-width: 640px;
    margin: 0 auto;
    padding: 80px clamp(20px, 4vw, 56px);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .sa-ed p {
    font-style: italic;
    font-weight: 500;
    font-size: clamp(22px, 2.4vw, 32px);
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: #0a0a0a;
    margin: 0;
    font-variation-settings: "WONK" 0, "SOFT" 40, "opsz" 144;
  }
  @media (max-width: 700px) {
    #shopify-section-{{ section.id }} .sa-ed { padding: 56px 20px; }
  }
{% endstyle %}

<section class="sa-ed">
  <p>{{ section.settings.text | default: 'We blend in small batches in Denver. Every jar is tasted before it ships.' | escape }}</p>
</section>

{% schema %}
{
  "name": "Shop All · Editorial",
  "settings": [
    { "type": "textarea", "id": "text", "label": "Line", "default": "We blend in small batches in Denver. Every jar is tasted before it ships." },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#f7f3ec" }
  ],
  "presets": [{ "name": "Shop All · Editorial", "category": "Shop All" }]
}
{% endschema %}

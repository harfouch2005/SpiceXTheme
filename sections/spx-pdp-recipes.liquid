{%- comment -%}
  SpiceX PDP recipes · pulls REAL recipes from the Recipes blog.
  Shows only articles tagged "product:<this product handle>" with a real photo.
  Renders NOTHING if no matching recipes exist (no placeholders, ever).
{%- endcomment -%}

{%- liquid
  assign recipe_blog = blogs['recipes']
  assign match_tag = 'product:' | append: product.handle
  assign matched = 0
-%}
{%- capture recipe_cards -%}
  {%- if recipe_blog != blank -%}
    {%- for a in recipe_blog.articles -%}
      {%- if matched >= 3 -%}{%- break -%}{%- endif -%}
      {%- liquid
        assign is_match = false
        assign a_img = ''
        assign a_total = ''
        assign a_serves = ''
        for tag in a.tags
          if tag == match_tag
            assign is_match = true
          elsif tag contains 'img:'
            assign a_img = tag | remove: 'img:'
          elsif tag contains 'total:'
            assign a_total = tag | remove: 'total:'
          elsif tag contains 'serves:'
            assign a_serves = tag | remove: 'serves:'
          endif
        endfor
      -%}
      {%- if is_match -%}
        {%- assign matched = matched | plus: 1 -%}
        <a class="spx-pr__card" href="{{ a.url }}">
          {%- if a_img != blank -%}
            <img class="spx-pr__img" src="{{ a_img | asset_url }}" alt="{{ a.title | escape }}" loading="lazy">
          {%- elsif a.image -%}
            <img class="spx-pr__img" src="{{ a.image | image_url: width: 800 }}" alt="{{ a.title | escape }}" loading="lazy">
          {%- endif -%}
          <div class="spx-pr__body">
            <p class="spx-pr__meta">{% if a_total != blank %}{{ a_total }}{% endif %}{% if a_total != blank and a_serves != blank %} · {% endif %}{% if a_serves != blank %}Serves {{ a_serves }}{% endif %}</p>
            <h3 class="spx-pr__title">{{ a.title }}</h3>
            <p class="spx-pr__ex">{{ a.excerpt_or_content | strip_html | truncate: 110 }}</p>
            <span class="spx-pr__link">Get recipe →</span>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

{%- if matched > 0 -%}
{% style %}
  #shopify-section-{{ section.id }} .spx-pr { background: {{ section.settings.bg_color | default: '#faf7f1' }}; font-family: var(--spx-font-body, 'DM Sans', sans-serif); padding: clamp(40px, 6vw, 80px) clamp(16px, 3vw, 40px); }
  #shopify-section-{{ section.id }} .spx-pr * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .spx-pr__wrap { max-width: 1180px; margin: 0 auto; }
  #shopify-section-{{ section.id }} .spx-pr__eyebrow { text-align: center; font-size: 11.5px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: #b0691e; margin: 0 0 10px; }
  #shopify-section-{{ section.id }} .spx-pr__eyebrow::before, #shopify-section-{{ section.id }} .spx-pr__eyebrow::after { content: '·'; margin: 0 10px; opacity: 0.5; }
  #shopify-section-{{ section.id }} .spx-pr__h { font-family: var(--spx-font-display); font-size: clamp(26px, 3.6vw, 40px); font-weight: 800; letter-spacing: -0.02em; text-align: center; color: #0a0a0a; margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .spx-pr__sub { text-align: center; color: #6b6b6b; font-size: 15px; font-style: italic; font-family: var(--spx-font-display); margin: 0 0 28px; }
  #shopify-section-{{ section.id }} .spx-pr__grid { display: grid; grid-template-columns: repeat({% if matched == 1 %}1{% elsif matched == 2 %}2{% else %}3{% endif %}, 1fr); gap: 20px; justify-content: center; }
  #shopify-section-{{ section.id }} .spx-pr__card { display: block; background: #fff; border: 1px solid #eee5d5; border-radius: 16px; overflow: hidden; text-decoration: none; color: #0a0a0a; transition: transform 0.25s ease, box-shadow 0.25s ease; max-width: 460px; margin: 0 auto; width: 100%; }
  #shopify-section-{{ section.id }} .spx-pr__card:hover { transform: translateY(-4px); box-shadow: 0 20px 44px -18px rgba(10,10,10,0.25); }
  #shopify-section-{{ section.id }} .spx-pr__img { width: 100%; aspect-ratio: 4/3; object-fit: cover; display: block; background: #f0e9da; }
  #shopify-section-{{ section.id }} .spx-pr__body { padding: 16px 18px 20px; }
  #shopify-section-{{ section.id }} .spx-pr__meta { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #9a9384; margin: 0 0 6px; }
  #shopify-section-{{ section.id }} .spx-pr__title { font-family: var(--spx-font-display); font-size: 19px; font-weight: 800; letter-spacing: -0.01em; margin: 0 0 8px; }
  #shopify-section-{{ section.id }} .spx-pr__ex { font-size: 13.5px; line-height: 1.5; color: #6b6b6b; margin: 0 0 12px; }
  #shopify-section-{{ section.id }} .spx-pr__link { font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #b0691e; }
  #shopify-section-{{ section.id }} .spx-pr__all { display: block; text-align: center; margin-top: 24px; font-size: 12.5px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: #0a0a0a; text-decoration: none; border-bottom: none; }
  #shopify-section-{{ section.id }} .spx-pr__all span { border-bottom: 2px solid #e8a823; padding-bottom: 3px; }
  @media (max-width: 860px) { #shopify-section-{{ section.id }} .spx-pr__grid { grid-template-columns: 1fr; } }
{% endstyle %}
<div class="spx-pr">
  <div class="spx-pr__wrap">
    <p class="spx-pr__eyebrow">Make it tonight</p>
    <h2 class="spx-pr__h">Cook with {{ product.title }}.</h2>
    <p class="spx-pr__sub">Real recipes from the SpiceX Cookbook, built around this jar.</p>
    <div class="spx-pr__grid">{{ recipe_cards }}</div>
    <a class="spx-pr__all" href="/blogs/recipes"><span>Browse all recipes →</span></a>
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "SpiceX PDP recipes",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#faf7f1" },
    { "type": "paragraph", "content": "Automatically shows up to 3 recipes from the Recipes blog tagged product:<this product's handle>. Renders nothing when there are no matching recipes." }
  ],
  "presets": [{ "name": "SpiceX PDP recipes" }]
}
{% endschema %}

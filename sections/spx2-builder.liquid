{%- comment -%}
  SpiceX box builder (S2). Price and savings live in a bar that pins to the top
  of the screen while the shopper picks jars. Pack tiers mirror the store's
  automatic discounts (3, 4, 5, 6 jars). When the cart reports a real discount
  the bar shows that number instead of the estimate.
{%- endcomment -%}
<style>
@media(max-width:749px){
  .s2-bx__bar.is-stuck .s2-bx__nudge{display:none}
  .s2-bx__bar.is-stuck .s2-bx__bar-in{padding:8px 14px 10px;row-gap:8px}
  .s2-bx__bar.is-stuck .s2-bx__go{min-height:42px}
}
.s2-bx__bar.is-stuck{z-index:39}
</style>
<section class="s2-bx" data-s2-bx>
  <div class="s2-bx__head">
    <h1 class="s2-h s2-bx__title">{{ section.settings.heading }}{% if section.settings.heading_accent != blank %} <span>{{ section.settings.heading_accent }}</span>{% endif %}</h1>
    {%- if section.settings.subheading != blank -%}<p class="s2-bx__sub">{{ section.settings.subheading }}</p>{%- endif -%}
    {%- if section.settings.all_label != blank -%}
      <button type="button" class="s2-bx__all" data-bx-all>{{ section.settings.all_label }}</button>
    {%- endif -%}
  </div>

  <div class="s2-bx__slot" data-bx-slot>
    <div class="s2-bx__bar" data-bx-bar role="region" aria-label="{{ section.settings.bar_label | escape }}">
      <div class="s2-bx__bar-in">
        <div class="s2-bx__sum" aria-live="polite">
          <span class="s2-bx__count" data-bx-count>0 jars</span>
          <span class="s2-bx__total"><b data-bx-total>$0.00</b><s data-bx-was hidden></s></span>
        </div>
        <span class="s2-bx__save" data-bx-save hidden></span>
        <a href="{{ routes.root_url }}checkout" class="s2-btn s2-bx__go" data-bx-go aria-disabled="true">{{ section.settings.checkout_label }}</a>
        <div class="s2-bx__prog">
          <ol class="s2-bx__steps" aria-hidden="true">
            <li data-bx-step="1"><i></i><span>1 jar</span></li>
            <li data-bx-step="2"><i></i><span>Free shipping</span></li>
            <li data-bx-step="3"><i></i><span data-bx-tier="3"></span></li>
            <li data-bx-step="4"><i></i><span data-bx-tier="4"></span></li>
            <li data-bx-step="5"><i></i><span data-bx-tier="5"></span></li>
            <li data-bx-step="6"><i></i><span data-bx-tier="6"></span></li>
          </ol>
          <p class="s2-bx__nudge" data-bx-nudge>2 jars ship free. 3 jars take ${{ section.settings.tier_3 | remove: ".00" }} off.</p>
        </div>
      </div>
    </div>
  </div>

  <div class="s2-bx__grid">
    {%- for block in section.blocks -%}
      {%- assign p = block.settings.product -%}
      {%- if p == blank -%}{%- continue -%}{%- endif -%}
      {%- assign v = p.selected_or_first_available_variant -%}
      {%- assign r_num = p.metafields.loox.num_reviews.value | default: p.metafields.loox.num_reviews -%}
      {%- assign r_avg = p.metafields.loox.avg_rating.value | default: p.metafields.loox.avg_rating -%}
      <article class="s2-bx__card" data-bx-tile data-variant-id="{{ v.id }}" data-name="{{ p.title | escape }}" style="--c:{{ block.settings.bg }};--cf:{{ block.settings.fg }}" {{ block.shopify_attributes }}>
        <a class="s2-bx__pic" href="{{ p.url }}" tabindex="-1" aria-hidden="true">
          {%- render 'spx2-jar', p: p, alt: '', size: 600 -%}
          {%- if block.settings.badge != blank -%}<span class="s2-bx__badge">{{ block.settings.badge }}</span>{%- endif -%}
          <span class="s2-bx__in" data-bx-in hidden></span>
        </a>
        <div class="s2-bx__body">
          <h2 class="s2-bx__name"><a href="{{ p.url }}">{{ p.title }}</a></h2>
          {%- if block.settings.tagline != blank -%}<p class="s2-bx__tag">{{ block.settings.tagline }}</p>{%- endif -%}
          <p class="s2-bx__meta">
            {%- if block.settings.heat != blank -%}<span>{{ block.settings.heat }}</span>{%- endif -%}
            {%- if r_num != blank and r_avg != blank -%}<span class="s2-bx__rate">★ {{ r_avg }} ({{ r_num }})</span>{%- endif -%}
          </p>
          <div class="s2-bx__buy">
            <span class="s2-bx__price">{{ v.price | money }}</span>
            {%- if v.available -%}
              <button type="button" class="s2-bx__add" data-bx-add aria-label="Add {{ p.title | escape }} to your box">{{ section.settings.add_label }}</button>
              <div class="s2-bx__stepper" data-bx-stepper hidden>
                <button type="button" data-bx-minus aria-label="Remove one {{ p.title | escape }}">&minus;</button>
                <span data-bx-qty aria-live="polite">0</span>
                <button type="button" data-bx-plus aria-label="Add one more {{ p.title | escape }}">+</button>
              </div>
            {%- else -%}
              <span class="s2-bx__out">{{ section.settings.soldout_label }}</span>
            {%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>

  <div class="s2-bx__recap" data-bx-recap hidden>
    <h2 class="s2-bx__recap-h">{{ section.settings.recap_heading }}</h2>
    <ul class="s2-bx__lines" data-bx-lines></ul>
    <dl class="s2-bx__rows">
      <div><dt>Subtotal</dt><dd data-bx-sub></dd></div>
      <div class="is-save" data-bx-saverow hidden><dt>Pack savings</dt><dd data-bx-saveamt></dd></div>
      <div><dt>Shipping</dt><dd data-bx-ship></dd></div>
      <div class="is-total"><dt>Estimated total</dt><dd data-bx-grand></dd></div>
    </dl>
    {%- if section.settings.disclaimer != blank -%}<p class="s2-bx__fine">{{ section.settings.disclaimer }}</p>{%- endif -%}
    <a href="{{ routes.root_url }}checkout" class="s2-btn s2-bx__go2" data-bx-go>{{ section.settings.checkout_label }}</a>
    <a href="{{ routes.cart_url }}" class="s2-bx__cartlink">{{ section.settings.cart_label }}</a>
  </div>
</section>

<script>
(function(){
  var root = document.querySelector('[data-s2-bx]');
  if (!root || root.dataset.ready) return;
  root.dataset.ready = '1';
  var TIERS = [
    { qty: 6, cents: {{ section.settings.tier_6 | times: 100 | round }} },
    { qty: 5, cents: {{ section.settings.tier_5 | times: 100 | round }} },
    { qty: 4, cents: {{ section.settings.tier_4 | times: 100 | round }} },
    { qty: 3, cents: {{ section.settings.tier_3 | times: 100 | round }} }
  ];
  var SINGLE_SHIP = {{ section.settings.single_ship | times: 100 | round }};
  var CART = {{ routes.cart_url | json }}.replace(/\/$/, '');
  var q = function(s){ return root.querySelector(s); };
  var qa = function(s){ return Array.prototype.slice.call(root.querySelectorAll(s)); };
  var tiles = qa('[data-bx-tile]');
  var byVariant = {};
  tiles.forEach(function(t){ byVariant[t.getAttribute('data-variant-id')] = t; });
  var el = {
    slot: q('[data-bx-slot]'), bar: q('[data-bx-bar]'), count: q('[data-bx-count]'),
    total: q('[data-bx-total]'), was: q('[data-bx-was]'), save: q('[data-bx-save]'),
    nudge: q('[data-bx-nudge]'), all: q('[data-bx-all]'), recap: q('[data-bx-recap]'),
    lines: q('[data-bx-lines]'), sub: q('[data-bx-sub]'), saverow: q('[data-bx-saverow]'),
    saveamt: q('[data-bx-saveamt]'), ship: q('[data-bx-ship]'), grand: q('[data-bx-grand]')
  };
  var gos = qa('[data-bx-go]');

  function money(c){ return '$' + (c / 100).toFixed(2); }
  function short(c){ return money(c).replace(/\.00$/, ''); }
  function tierFor(n){ for (var i = 0; i < TIERS.length; i++) { if (n >= TIERS[i].qty) return TIERS[i].cents; } return 0; }
  function nextTier(n){ for (var i = TIERS.length - 1; i >= 0; i--) { if (n < TIERS[i].qty) return TIERS[i]; } return null; }

  qa('[data-bx-tier]').forEach(function(s){
    var n = parseInt(s.getAttribute('data-bx-tier'), 10);
    var t = TIERS.filter(function(x){ return x.qty === n; })[0];
    if (t) s.textContent = short(t.cents) + ' off';
  });

  var lastTotal = null;
  function render(cart){
    var jars = 0, qty = {};
    cart.items.forEach(function(it){
      var id = String(it.variant_id);
      qty[id] = (qty[id] || 0) + it.quantity;
      if (byVariant[id]) jars += it.quantity;
    });
    var missing = 0;
    tiles.forEach(function(t){
      var n = qty[t.getAttribute('data-variant-id')] || 0;
      var add = t.querySelector('[data-bx-add]'), st = t.querySelector('[data-bx-stepper]'), badge = t.querySelector('[data-bx-in]');
      if (!add || !st) return;
      if (n === 0) missing++;
      t.classList.toggle('is-in', n > 0);
      add.hidden = n > 0;
      st.hidden = n === 0;
      st.querySelector('[data-bx-qty]').textContent = n;
      if (badge) { badge.hidden = n === 0; badge.textContent = n + ' in box'; }
    });
    if (el.all) el.all.hidden = missing === 0;

    var est = tierFor(jars);
    var real = cart.total_discount || 0;
    var savings = real > 0 ? real : est;
    var orig = cart.original_total_price;
    var total = real > 0 ? cart.total_price : Math.max(orig - est, 0);
    var others = cart.item_count - jars;

    el.count.textContent = (jars === 1 ? '1 jar' : jars + ' jars') + (others > 0 ? ' + ' + others + ' more' : '');
    el.total.textContent = money(total);
    if (lastTotal !== null && lastTotal !== total) {
      el.bar.classList.remove('is-bump');
      void el.bar.offsetWidth;
      el.bar.classList.add('is-bump');
    }
    lastTotal = total;
    el.was.hidden = savings <= 0;
    el.was.textContent = money(orig);
    el.save.hidden = savings <= 0;
    el.save.textContent = 'You save ' + short(savings);

    qa('[data-bx-step]').forEach(function(s){
      s.classList.toggle('is-on', jars >= parseInt(s.getAttribute('data-bx-step'), 10));
    });

    var nt = nextTier(jars), need = nt ? nt.qty - jars : 0, msg;
    if (jars === 0) msg = '2 jars ship free. 3 jars take ' + short(TIERS[3].cents) + ' off.';
    else if (jars === 1) msg = 'Add 1 more jar and shipping is free.';
    else if (nt) msg = (jars === 2 ? 'Free shipping unlocked. ' : '') + 'Add ' + need + ' more ' + (need === 1 ? 'jar' : 'jars') + ' to save ' + short(nt.cents) + '.';
    else msg = 'Best price unlocked. ' + short(savings) + ' off and free shipping.';
    el.nudge.textContent = msg;
    el.nudge.classList.toggle('is-max', !nt);

    var empty = cart.item_count === 0;
    gos.forEach(function(g){ if (empty) g.setAttribute('aria-disabled', 'true'); else g.removeAttribute('aria-disabled'); });
    el.recap.hidden = empty;
    if (!empty) {
      el.lines.innerHTML = '';
      cart.items.forEach(function(it){
        var li = document.createElement('li');
        var t = byVariant[String(it.variant_id)];
        if (t) li.style.setProperty('--c', t.style.getPropertyValue('--c'));
        var n = document.createElement('span'); n.className = 's2-bx__ln'; n.textContent = it.product_title;
        var c = document.createElement('span'); c.className = 's2-bx__lq'; c.textContent = '×' + it.quantity;
        var p = document.createElement('span'); p.className = 's2-bx__lp'; p.textContent = money(it.original_line_price);
        li.appendChild(n); li.appendChild(c); li.appendChild(p);
        el.lines.appendChild(li);
      });
      el.sub.textContent = money(orig);
      el.saverow.hidden = savings <= 0;
      el.saveamt.textContent = '−' + money(savings);
      var freeShip = jars >= 2 || others > 0;
      el.ship.textContent = freeShip ? (others > 0 && jars < 2 ? 'Calculated at checkout' : 'Free') : money(SINGLE_SHIP);
      el.grand.textContent = money(total + (freeShip ? 0 : SINGLE_SHIP));
    }
    place();
  }

  function refresh(){
    return fetch(CART + '.js', { headers: { 'Accept': 'application/json' } })
      .then(function(r){ return r.json(); })
      .then(function(cart){ render(cart); return cart; });
  }
  function announce(cart){ window.dispatchEvent(new CustomEvent('cart:updated', { detail: cart })); }
  function post(path, body){
    return fetch(CART + path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(body)
    }).then(function(r){ if (!r.ok) throw new Error('cart'); return r.json(); });
  }
  function change(tile, delta){
    if (tile.classList.contains('is-busy')) return;
    tile.classList.add('is-busy');
    var id = tile.getAttribute('data-variant-id');
    var cur = parseInt(tile.querySelector('[data-bx-qty]').textContent, 10) || 0;
    var req = (delta > 0 && cur === 0)
      ? post('/add.js', { id: parseInt(id, 10), quantity: 1 })
      : post('/change.js', { id: id, quantity: Math.max(cur + delta, 0) });
    req.then(refresh).then(announce)
      .catch(function(){ refresh(); })
      .then(function(){ tile.classList.remove('is-busy'); });
  }
  tiles.forEach(function(t){
    var a = t.querySelector('[data-bx-add]');
    if (!a) return;
    a.addEventListener('click', function(){ change(t, 1); });
    t.querySelector('[data-bx-plus]').addEventListener('click', function(){ change(t, 1); });
    t.querySelector('[data-bx-minus]').addEventListener('click', function(){ change(t, -1); });
  });
  if (el.all) el.all.addEventListener('click', function(){
    if (el.all.disabled) return;
    var items = tiles.filter(function(t){ return t.querySelector('[data-bx-add]') && !t.classList.contains('is-in'); })
      .map(function(t){ return { id: parseInt(t.getAttribute('data-variant-id'), 10), quantity: 1 }; });
    if (!items.length) return;
    el.all.disabled = true;
    post('/add.js', { items: items }).then(refresh).then(announce)
      .catch(function(){ refresh(); })
      .then(function(){ el.all.disabled = false; });
  });
  gos.forEach(function(g){ g.addEventListener('click', function(e){ if (g.getAttribute('aria-disabled') === 'true') e.preventDefault(); }); });
  window.addEventListener('cart:updated', function(e){ if (e.detail && e.detail.items) render(e.detail); });

  /* Pin the price bar under the header while the builder is on screen */
  function headerBottom(){
    var c = ['.spx-h-section', '#shopify-section-spx-header', '.header-wrapper--sticky', '.header-sticky-wrapper', '#SiteHeader'];
    var best = 0;
    for (var i = 0; i < c.length; i++) {
      var h = document.querySelector(c[i]);
      if (!h) continue;
      var pos = getComputedStyle(h).position;
      if (pos === 'fixed' || pos === 'sticky') {
        var b = h.getBoundingClientRect();
        if (b.top <= 1 && b.bottom > best) best = b.bottom;
      }
    }
    return Math.max(0, Math.round(best));
  }
  var ticking = false;
  function place(){
    var top = headerBottom();
    var h = el.bar.offsetHeight;
    var s = el.slot.getBoundingClientRect();
    var r = root.getBoundingClientRect();
    var stuck = s.top < top;
    if (stuck) {
      el.slot.style.minHeight = h + 'px';
      el.bar.style.top = top + 'px';
      el.bar.classList.add('is-stuck');
    } else {
      el.bar.classList.remove('is-stuck');
      el.bar.style.top = '';
      el.slot.style.minHeight = '';
    }
  }
  function onScroll(){
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function(){ ticking = false; place(); });
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);

  refresh();
})();
</script>

{% schema %}
{
  "name": "S2 Box builder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Build your box." },
    { "type": "text", "id": "heading_accent", "label": "Heading accent" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "all_label", "label": "Add one of each label" },
    { "type": "text", "id": "bar_label", "label": "Price bar name for screen readers", "default": "Your box total" },
    { "type": "text", "id": "add_label", "label": "Add label", "default": "Add" },
    { "type": "text", "id": "soldout_label", "label": "Sold out label", "default": "Sold out" },
    { "type": "text", "id": "checkout_label", "label": "Checkout label", "default": "Checkout" },
    { "type": "text", "id": "cart_label", "label": "Cart link label", "default": "View cart" },
    { "type": "text", "id": "recap_heading", "label": "Recap heading", "default": "Your box" },
    { "type": "text", "id": "disclaimer", "label": "Fine print" },
    { "type": "header", "content": "Pack savings (match the automatic discounts)" },
    { "type": "text", "id": "tier_3", "label": "3 jars", "default": "5.00" },
    { "type": "text", "id": "tier_4", "label": "4 jars", "default": "6.00" },
    { "type": "text", "id": "tier_5", "label": "5 jars", "default": "7.00" },
    { "type": "text", "id": "tier_6", "label": "6 jars", "default": "12.95" },
    { "type": "text", "id": "single_ship", "label": "Shipping for one jar", "default": "4.99" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Flavor",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "color", "id": "bg", "label": "Flavor color", "default": "#D23C14" },
        { "type": "color", "id": "fg", "label": "Text on flavor color", "default": "#FFFFFF" },
        { "type": "text", "id": "tagline", "label": "One line" },
        { "type": "text", "id": "heat", "label": "Heat" },
        { "type": "text", "id": "badge", "label": "Badge" }
      ]
    }
  ],
  "presets": [{ "name": "S2 Box builder" }]
}
{% endschema %}

{%- comment -%}
  SpiceX PDP · Sticky mobile Add-to-Cart bar (appears after scrolling past hero ATC)
{%- endcomment -%}

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap">

{% style %}
  #shopify-section-{{ section.id }} {
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .pdp-st {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 90;
    background: #ffffff;
    border-top: 1px solid rgba(0,0,0,0.08);
    padding: 10px 16px;
    box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.08);
    display: none;
    font-family: var(--spx-font-body);
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }
  #shopify-section-{{ section.id }} .pdp-st.is-visible {
    transform: translateY(0);
  }
  #shopify-section-{{ section.id }} .pdp-st-inner {
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: 720px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .pdp-st-img {
    width: 44px;
    height: 44px;
    border-radius: 6px;
    object-fit: contain;
    background: #fbf8f2;
    padding: 4px;
    flex: 0 0 auto;
  }
  #shopify-section-{{ section.id }} .pdp-st-body { flex: 1; min-width: 0; }
  #shopify-section-{{ section.id }} .pdp-st-name {
    font-family: var(--spx-font-display);
    font-weight: 600;
    font-size: 14px;
    color: #0a0a0a;
    line-height: 1.2;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variation-settings: "WONK" 0, "SOFT" 30;
  }
  #shopify-section-{{ section.id }} .pdp-st-price {
    font-size: 12px;
    color: #555;
    margin-top: 2px;
  }
  #shopify-section-{{ section.id }} .pdp-st-btn {
    background: #0a0a0a;
    color: #ffffff;
    border: 0;
    padding: 12px 18px;
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    cursor: pointer;
    line-height: 1;
    transition: background 0.2s ease, transform 0.2s ease;
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  #shopify-section-{{ section.id }} .pdp-st-btn:hover { background: {{ section.settings.accent_color | default: '#0099d6' }}; transform: translateY(-1px); }
  #shopify-section-{{ section.id }} .pdp-st-btn:disabled { opacity: 0.6; cursor: wait; }
  #shopify-section-{{ section.id }} .pdp-st-btn-default,
  #shopify-section-{{ section.id }} .pdp-st-btn-loading,
  #shopify-section-{{ section.id }} .pdp-st-btn-added { display: inline-flex; align-items: center; gap: 6px; }
  #shopify-section-{{ section.id }} .pdp-st-btn-loading,
  #shopify-section-{{ section.id }} .pdp-st-btn-added { display: none; }
  #shopify-section-{{ section.id }} .pdp-st-btn.is-loading .pdp-st-btn-default { display: none; }
  #shopify-section-{{ section.id }} .pdp-st-btn.is-loading .pdp-st-btn-loading { display: inline-flex; }
  #shopify-section-{{ section.id }} .pdp-st-btn.is-added .pdp-st-btn-default { display: none; }
  #shopify-section-{{ section.id }} .pdp-st-btn.is-added .pdp-st-btn-added { display: inline-flex; }
  #shopify-section-{{ section.id }} .pdp-st-spin { width: 10px; height: 10px; border: 2px solid rgba(255,255,255,0.3); border-top-color: #fff; border-radius: 50%; animation: pdp-st-spin 0.7s linear infinite; }
  @keyframes pdp-st-spin { to { transform: rotate(360deg); } }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .pdp-st { display: block; }
    body { padding-bottom: 72px; }
  }
{% endstyle %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
-%}

<div class="pdp-st" data-pdp-st aria-hidden="true">
  <div class="pdp-st-inner">
    {%- if product.featured_image != blank -%}
      <img class="pdp-st-img" src="{{ product.featured_image | image_url: width: 120 }}" alt="">
    {%- endif -%}
    <div class="pdp-st-body">
      <div class="pdp-st-name">{{ product.title | escape }}</div>
      <div class="pdp-st-price">{{ current_variant.price | money }}</div>
    </div>
    <button type="button" class="pdp-st-btn" data-pdp-st-add data-variant-id="{{ current_variant.id }}">
      <span class="pdp-st-btn-default">Add · {{ current_variant.price | money }}</span>
      <span class="pdp-st-btn-loading"><span class="pdp-st-spin" aria-hidden="true"></span>Adding</span>
      <span class="pdp-st-btn-added">Added ✓</span>
    </button>
  </div>
</div>

<script>
  (function() {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section) return;
    var bar = section.querySelector('[data-pdp-st]');
    if (!bar) return;

    // Trigger: show bar when main PDP ATC button scrolls out of view
    var heroAtc = document.querySelector('[data-pdp-atc]');
    if (heroAtc && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            bar.classList.remove('is-visible');
            bar.setAttribute('aria-hidden', 'true');
          } else if (entry.boundingClientRect.top < 0) {
            bar.classList.add('is-visible');
            bar.setAttribute('aria-hidden', 'false');
          }
        });
      }, { threshold: 0 });
      io.observe(heroAtc);
    } else {
      // Fallback: always visible if no observer support
      bar.classList.add('is-visible');
    }

    // ATC handler
    var btn = section.querySelector('[data-pdp-st-add]');
    if (btn) {
      btn.addEventListener('click', function() {
        var variantId = btn.getAttribute('data-variant-id');
        if (!variantId || btn.disabled) return;
        btn.classList.add('is-loading'); btn.classList.remove('is-added'); btn.disabled = true;
        fetch('/cart/add.js', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id: variantId, quantity: 1 }) })
          .then(function(r) { if (!r.ok) throw new Error('add failed'); return r.json(); })
          .then(function() { return fetch('/cart.js'); })
          .then(function(r) { return r.json(); })
          .then(function(cart) {
            window.dispatchEvent(new CustomEvent('cart:updated', { detail: cart }));
            btn.classList.remove('is-loading'); btn.classList.add('is-added');
            setTimeout(function() { btn.classList.remove('is-added'); btn.disabled = false; }, 1500);
          })
          .catch(function(err) { console.error(err); btn.classList.remove('is-loading'); btn.disabled = false; });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "PDP · Sticky ATC",
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Hover accent", "default": "#0099d6" }
  ],
  "presets": [{ "name": "PDP · Sticky ATC", "category": "Product" }]
}
{% endschema %}

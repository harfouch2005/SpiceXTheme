<style>
.s2-pdp__nav{top:calc((100% - var(--th,0px)) / 2)}
.s2-pdp__thumbs{position:relative;display:flex;gap:8px;margin-top:10px;overflow-x:auto;scrollbar-width:none;padding:3px}
.s2-pdp__thumbs::-webkit-scrollbar{display:none}
.s2-pdp__thumb{flex:0 0 auto;width:60px;height:60px;border-radius:12px;overflow:hidden;border:0;padding:0;background:var(--s2-sand);cursor:pointer;opacity:.62;transition:opacity .15s ease}
.s2-pdp__thumb.is-on{opacity:1;box-shadow:0 0 0 2.5px var(--s2-ink)}
.s2-pdp__thumb img{width:100%;height:100%;object-fit:cover;display:block}
@media(min-width:900px){.s2-pdp__thumb{width:74px;height:74px;border-radius:14px}.s2-pdp__thumbs{gap:10px}}
</style>
<section class="s2-pdp" style="--bg:{{ section.settings.bg }};--fg:{{ section.settings.fg }}">
  <nav class="s2-crumb" aria-label="Breadcrumb"><a href="{{ section.settings.shop_link }}">{{ section.settings.shop_label }}</a><span aria-hidden="true">/</span><span>{{ product.title }}</span></nav>
  <div class="s2-pdp__grid">
    <div class="s2-pdp__media" data-s2-gal>
      <div class="s2-pdp__track">
        {%- assign model_handles = 'daily-blend,taco-blast,sweet-sriracha,golden-hive,bella-blend,oh-cajun' | split: ',' -%}
        {%- assign has_models = false -%}
        {%- if model_handles contains product.handle -%}
          {%- assign has_models = true -%}
          {%- assign studio_name = 'spx-model-studio-' | append: product.handle | append: '-sq.png' -%}
          {%- assign life_name = 'spx-model-life-' | append: product.handle | append: '-sq.png' -%}
        {%- endif -%}
        {%- if section.settings.hero_image != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: "eager", fetchpriority: "high", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if has_models -%}
          <div class="s2-pdp__slide">{{ images[studio_name] | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.image_2 != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.image_2 | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if has_models -%}
          <div class="s2-pdp__slide">{{ images[life_name] | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.image_3 != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.image_3 | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.image_4 != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.image_4 | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.image_5 != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.image_5 | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.image_6 != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.image_6 | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.image_7 != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.image_7 | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.image_8 != blank -%}
          <div class="s2-pdp__slide">{{ section.settings.image_8 | image_url: width: 1200 | image_tag: loading: "lazy", widths: "500, 800, 1200", sizes: "(min-width: 900px) 560px, 100vw" }}</div>
        {%- endif -%}
        {%- if section.settings.show_gallery -%}{%- for img in product.images -%}
          {%- if forloop.index > 1 -%}{%- break -%}{%- endif -%}
          {%- assign src_l = img.src | downcase -%}
          {%- if src_l contains 'nutrition' or src_l contains 'background' or src_l contains 'gps_generated' -%}{%- continue -%}{%- endif -%}
          <div class="s2-pdp__slide{% if forloop.first %} is-jar{% endif %}">
            {%- if forloop.first -%}
              {{ img | image_url: width: 1000 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '500, 800, 1000', sizes: '(min-width: 900px) 420px, 60vw', alt: product.title }}
            {%- else -%}
              {{ img | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 900px) 560px, 100vw' }}
            {%- endif -%}
          </div>
        {%- endfor -%}{%- endif -%}
      </div>
      <button type="button" class="s2-pdp__nav s2-pdp__nav--prev" data-s2-prev aria-label="{{ section.settings.prev_label }}">‹</button>
      <button type="button" class="s2-pdp__nav s2-pdp__nav--next" data-s2-next aria-label="{{ section.settings.next_label }}">›</button>
    </div>
    <div class="s2-pdp__info">
      <h1 class="s2-pdp__title">{{ product.title }}</h1>
      <p class="s2-pdp__sum">{{ section.settings.summary }}{% if section.settings.attrs != blank %}<strong>{{ section.settings.attrs }}</strong>{% endif %}</p>
      <p class="s2-pdp__meta">
        {%- assign avg = product.metafields.loox.avg_rating.value | default: product.metafields.loox.avg_rating -%}
        {%- assign num = product.metafields.loox.num_reviews.value | default: product.metafields.loox.num_reviews -%}
        {%- if num != blank and avg != blank -%}
          <a href="#looxReviews"><span class="s2-rate" style="--r:{{ avg }}" aria-hidden="true">★★★★★</span>{{ avg }} ({{ num }})</a>
        {%- endif -%}
        {%- if section.settings.label_link != blank -%}<a class="s2-pdp__lab" href="#s2-label">{{ section.settings.label_link }}</a>{%- endif -%}
      </p>
      {%- if product.available -%}
        <form method="post" action="{{ routes.cart_add_url }}">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="s2-btn">{{ section.settings.button_label }} · {{ product.price | money }}</button>
        </form>
      {%- else -%}
        <p class="s2-pdp__ship">{{ section.settings.soldout_label }}</p>
      {%- endif -%}
      {%- if section.settings.ship_note != blank -%}<p class="s2-pdp__ship">{{ section.settings.ship_note }}</p>{%- endif -%}
      {%- if section.settings.box_title != blank -%}
        <a class="s2-pdp__box" href="{{ section.settings.box_link }}"><strong>{{ section.settings.box_title }}</strong>{{ section.settings.box_text }}</a>
      {%- endif -%}
    </div>
  </div>
</section>
<script>
  (function(){
    document.querySelectorAll('[data-s2-gal]').forEach(function(g){
      if (g.dataset.s2Bound) return;
      g.dataset.s2Bound = '1';
      var t = g.querySelector('.s2-pdp__track');
      var prev = g.querySelector('[data-s2-prev]');
      var next = g.querySelector('[data-s2-next]');
      if (!t || t.children.length < 2) { if (prev) prev.hidden = true; if (next) next.hidden = true; return; }
      var smooth = window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';
      prev.addEventListener('click', function(){ t.scrollBy({ left: -t.clientWidth, behavior: smooth }); });
      next.addEventListener('click', function(){ t.scrollBy({ left: t.clientWidth, behavior: smooth }); });
      var slides = Array.prototype.slice.call(t.children);
      var thumbs = document.createElement('div');
      thumbs.className = 's2-pdp__thumbs';
      slides.forEach(function(s, i){
        var im = s.querySelector('img');
        if (!im) return;
        var b = document.createElement('button');
        b.type = 'button';
        b.className = 's2-pdp__thumb' + (i === 0 ? ' is-on' : '');
        b.setAttribute('aria-label', 'Photo ' + (i + 1) + ' of ' + slides.length);
        var ti = document.createElement('img');
        ti.src = (im.getAttribute('src') || '').replace(/([?&]width=)\d+/, '$1160');
        ti.alt = '';
        ti.loading = 'eager';
        b.appendChild(ti);
        b.addEventListener('click', function(){ t.scrollTo({ left: i * t.clientWidth, behavior: smooth }); });
        thumbs.appendChild(b);
      });
      g.appendChild(thumbs);
      g.style.setProperty('--th', (thumbs.offsetHeight + 10) + 'px');
      var tick = false;
      t.addEventListener('scroll', function(){
        if (tick) return;
        tick = true;
        requestAnimationFrame(function(){
          tick = false;
          var i = Math.round(t.scrollLeft / t.clientWidth);
          Array.prototype.forEach.call(thumbs.children, function(b, k){
            var on = k === i;
            b.classList.toggle('is-on', on);
            if (on && thumbs.scrollWidth > thumbs.clientWidth) thumbs.scrollTo({ left: b.offsetLeft - thumbs.clientWidth / 2 + b.offsetWidth / 2, behavior: smooth });
          });
        });
      }, { passive: true });
    });
  })();
</script>
{% schema %}
{
  "name": "S2 Product",
  "settings": [
    { "type": "color", "id": "bg", "label": "Blend color", "default": "#4D5057" },
    { "type": "color", "id": "fg", "label": "Text on blend color", "default": "#FFFFFF" },
    { "type": "image_picker", "id": "hero_image", "label": "First photo (studio shot)" },
    { "type": "image_picker", "id": "image_2", "label": "Second photo (jar with a dish)" },
    { "type": "image_picker", "id": "image_3", "label": "Third photo" },
    { "type": "image_picker", "id": "image_4", "label": "Photo 4" },
    { "type": "image_picker", "id": "image_5", "label": "Photo 5" },
    { "type": "image_picker", "id": "image_6", "label": "Photo 6" },
    { "type": "image_picker", "id": "image_7", "label": "Photo 7" },
    { "type": "image_picker", "id": "image_8", "label": "Photo 8" },
    { "type": "checkbox", "id": "show_gallery", "label": "Show the plain jar photo after the studio photos", "default": true },
    { "type": "text", "id": "shop_label", "label": "Breadcrumb label", "default": "Shop" },
    { "type": "url", "id": "shop_link", "label": "Breadcrumb link" },
    { "type": "textarea", "id": "summary", "label": "One sentence on what it is" },
    { "type": "text", "id": "attrs", "label": "Key facts (bold line)" },
    { "type": "text", "id": "label_link", "label": "Label link text", "default": "See the nutrition label" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add to cart" },
    { "type": "text", "id": "soldout_label", "label": "Sold out text", "default": "Sold out" },
    { "type": "text", "id": "ship_note", "label": "Line under button", "default": "2 or more jars ship free." },
    { "type": "text", "id": "box_title", "label": "Box offer title", "default": "Build a box and save" },
    { "type": "text", "id": "box_text", "label": "Box offer text", "default": "3 jars save $5. All six save $12.95." },
    { "type": "url", "id": "box_link", "label": "Box offer link" },
    { "type": "text", "id": "prev_label", "label": "Previous photo label", "default": "Previous photo" },
    { "type": "text", "id": "next_label", "label": "Next photo label", "default": "Next photo" }
  ]
}
{% endschema %}
